#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

FileUtils.chdir APP_ROOT do
  # Signpost has a richer setup flow than the default Rails scaffold:
  # creating the postgres role, generating credentials, and symlinking
  # into puma-dev. Delegate to setup:install so there is one canonical
  # path for new contributors.
  exec "bin/rails", "setup:install"
end
