<%= turbo_stream.replace dom_id(@commitment) do %>
  <div class="card flex items-center gap opacity-50">
    <i class="ph ph-check-circle text-positive"></i>
    <span class="text-sm line-through text-subtle flex-1"><%= @commitment.text %></span>
    <span class="text-xs text-subtle">Done</span>
  </div>
<% end %>
