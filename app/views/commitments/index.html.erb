<% content_for(:title, "Commitments — Tech Lead OS") %>

<div class="flex items-center justify-between mbe-6">
  <h1 class="font-bold text-2xl">Commitments</h1>
  <%= link_to new_commitment_path, class: "btn btn--primary" do %><i class="ph ph-plus"></i> New Commitment<% end %>
</div>

<% if @overdue.any? %>
  <h2 class="font-bold text-sm mbe-2 text-negative">
    <i class="ph ph-warning-circle"></i> Overdue
  </h2>
  <div class="flex flex-col gap mbe-6">
    <% @overdue.each do |c| %>
      <%= render "commitment_row", commitment: c %>
    <% end %>
  </div>
<% end %>

<% if @due_soon.any? %>
  <h2 class="font-bold text-sm mbe-2 text-subtle">
    <i class="ph ph-clock"></i> Due Soon
  </h2>
  <div class="flex flex-col gap mbe-6">
    <% @due_soon.each do |c| %>
      <%= render "commitment_row", commitment: c %>
    <% end %>
  </div>
<% end %>

<% if @no_date.any? %>
  <h2 class="font-bold text-sm mbe-2 text-subtle">
    <i class="ph ph-list-bullets"></i> No Due Date
  </h2>
  <div class="flex flex-col gap mbe-6">
    <% @no_date.each do |c| %>
      <%= render "commitment_row", commitment: c %>
    <% end %>
  </div>
<% end %>

<% if @overdue.empty? && @due_soon.empty? && @no_date.empty? %>
  <div class="card text-center text-subtle">
    <i class="ph ph-check-circle mbe-4 text-4xl block text-positive"></i>
    <p>No pending commitments.</p>
  </div>
<% end %>

<% if @done_recent.any? %>
  <details class="mbs-4">
    <summary class="text-sm font-bold text-subtle cursor-pointer">
      <i class="ph ph-check-square"></i> Done (last 10)
    </summary>
    <div class="flex flex-col gap mbs-2">
      <% @done_recent.each do |c| %>
        <div class="card flex items-center gap opacity-50">
          <i class="ph ph-check-circle text-positive"></i>
          <span class="text-sm line-through flex-1"><%= c.text %></span>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
