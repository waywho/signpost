<% content_for(:title, "Log PR Review — Tech Lead OS") %>

<div class="container mbs-6" style="max-inline-size: 40rem">
  <div class="mbe-4">
    <%= link_to pr_reviews_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
      <i class="ph ph-caret-left"></i> PR Reviews
    <% end %>
  </div>

  <h1 class="font-bold text-2xl mbe-6">Log a PR Review</h1>

  <div class="card">
    <%= form_with model: @pr_review, class: "flex flex-col gap" do |f| %>
      <% if @pr_review.errors.any? %>
        <div class="alert alert--negative">
          <ul class="text-sm"><% @pr_review.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
        </div>
      <% end %>

      <div class="flex gap">
        <div style="flex: 1">
          <%= f.label :repo, "Repository", class: "text-sm font-bold mbe-1", style: "display: block" %>
          <%= f.text_field :repo, class: "input", placeholder: "org/repo", required: true %>
        </div>
        <div style="flex: 0 0 6rem">
          <%= f.label :pr_number, "PR #", class: "text-sm font-bold mbe-1", style: "display: block" %>
          <%= f.number_field :pr_number, class: "input", required: true %>
        </div>
      </div>

      <div><%= f.label :pr_title, "Title", class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.text_field :pr_title, class: "input" %></div>
      <div><%= f.label :pr_author, "Author", class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.text_field :pr_author, class: "input" %></div>

      <div class="flex gap">
        <div style="flex: 1">
          <%= f.label :recommendation, class: "text-sm font-bold mbe-1", style: "display: block" %>
          <%= f.select :recommendation, [["—", ""], ["Approve", "approve"], ["Request Changes", "request_changes"], ["Needs Discussion", "needs_discussion"]], {}, class: "input" %>
        </div>
        <div style="flex: 1">
          <%= f.label :risk_level, class: "text-sm font-bold mbe-1", style: "display: block" %>
          <%= f.select :risk_level, [["—", ""], ["Low", "low"], ["Medium", "medium"], ["High", "high"], ["Critical", "critical"]], {}, class: "input" %>
        </div>
      </div>

      <div><%= f.label :summary, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.text_area :summary, class: "input", rows: 3 %></div>
      <div><%= f.label :draft_comment, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.text_area :draft_comment, class: "input", rows: 3 %></div>

      <div class="flex gap">
        <div style="flex: 1"><%= f.label :files_changed, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.number_field :files_changed, class: "input" %></div>
        <div style="flex: 1"><%= f.label :additions, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.number_field :additions, class: "input" %></div>
        <div style="flex: 1"><%= f.label :deletions, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.number_field :deletions, class: "input" %></div>
      </div>

      <div><%= f.label :reviewed_at, class: "text-sm font-bold mbe-1", style: "display: block" %><%= f.datetime_local_field :reviewed_at, class: "input", value: @pr_review.reviewed_at&.strftime("%Y-%m-%dT%H:%M") %></div>

      <div class="flex items-center gap"><%= f.submit "Log Review", class: "btn btn--primary" %><%= link_to "Cancel", pr_reviews_path, class: "btn btn--borderless" %></div>
    <% end %>
  </div>
</div>
