<% content_for(:title, "PR Analysis — ##{@pr_number} — Tech Lead OS") %>

<div class="mbe-4">
  <%= link_to pr_reviews_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> PR Reviews
  <% end %>
</div>

<div class="flex items-center justify-between mbe-4">
  <h1 class="font-bold text-2xl">
    <span style="color: var(--color-text-subtle)">#<%= @pr_number %></span>
    <%= @pr_title || "PR Analysis" %>
  </h1>
</div>

<% if @analysis %>
  <%# Cached — render instantly %>
  <%= render "pr_reviews/analysis", analysis: @analysis, cc_command: @cc_command, repo: @repo, pr_number: @pr_number %>
<% else %>
  <% if @has_stale_analysis %>
    <div class="alert mbe-4" style="background: light-dark(var(--amber-100), var(--amber-950)); color: #f97316">
      <p class="text-sm"><i class="ph ph-warning"></i> New commits detected since last analysis. Re-analyzing...</p>
    </div>
  <% end %>
  <%# Not cached — stream from Claude %>
  <div data-controller="pr-analysis-stream"
       data-pr-analysis-stream-url-value="<%= pr_reviews_analysis_path(repo: @repo, pr_number: @pr_number, pr_title: @pr_title, pr_author: @pr_author) %>">

    <div data-loader>
      <div class="card text-center p-4">
        <div style="font-size: var(--text-4xl); color: var(--color-primary); animation: spin 1s linear infinite; margin-block-end: var(--size-4)">
          <i class="ph ph-spinner"></i>
        </div>
        <p class="text-sm" data-pr-analysis-stream-target="status" style="color: var(--color-text-subtle)">Connecting...</p>
      </div>
    </div>

    <pre class="card text-sm p-4" data-pr-analysis-stream-target="stream" hidden
         style="white-space: pre-wrap; font-family: monospace; max-block-size: 30rem; overflow-y: auto; background: var(--color-secondary)"></pre>

    <div data-pr-analysis-stream-target="result" hidden></div>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
<% end %>
