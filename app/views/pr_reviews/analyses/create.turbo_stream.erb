<%= turbo_stream.replace "pr_analysis" do %>
  <div id="pr_analysis">
    <% if @error %>
      <div class="alert alert--negative mbs-4">
        <p class="text-sm"><i class="ph ph-warning"></i> Analysis failed: <%= @error %></p>
      </div>
    <% else %>
      <%= render "pr_reviews/analysis", analysis: @analysis, cc_command: @cc_command %>
    <% end %>
  </div>
<% end %>
