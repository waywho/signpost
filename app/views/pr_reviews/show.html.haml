- content_for(:title, "##{@pr_review.pr_number} — PR Reviews — Vane")
.mbe-4
  = link_to pr_reviews_path, class: "flex items-center gap-half text-sm text-subtle" do
    %i.ph.ph-caret-left
    PR Reviews
.card.mbe-4
  .flex.items-center.gap.mbe-2
    - if @pr_review.recommendation.present?
      %span{:class => "badge #{recommendation_badge_variant(@pr_review.recommendation)}"}= @pr_review.recommendation.tr("_", " ")
    - if @pr_review.risk_level.present?
      %span{:class => "badge #{risk_badge_variant(@pr_review.risk_level)}"}
        %i.ph.ph-shield-warning
        = @pr_review.risk_level
  .flex.items-center.justify-between.mbe-2
    %h1.font-bold.text-xl
      %span.text-subtle
        \##{@pr_review.pr_number}
      = @pr_review.pr_title.presence || "(no title)"
    - if @claude_configured && @github_configured
      #pr_reanalyze_button
        - if @job_running
          %button.btn.btn--borderless{:disabled => "disabled"}
            %i.ph.ph-spinner.animate-spin
            Re-analyzing…
        - else
          = button_to pr_review_analysis_path(@pr_review), method: :post, class: "btn btn--borderless" do
            %i.ph.ph-arrow-clockwise
            Re-analyze
  .flex.items-center.gap.text-sm.text-subtle
    %span
      %i.ph.ph-git-branch
      = @pr_review.repo
    - if @pr_review.pr_author.present?
      %span
        %i.ph.ph-user
        = @pr_review.pr_author
    - if @pr_review.reviewed_at
      %span= @pr_review.reviewed_at.strftime("%b %-d, %Y")
  - if @pr_review.files_changed || @pr_review.additions || @pr_review.deletions
    .flex.items-center.gap.text-sm.mbs-2
      - if @pr_review.files_changed
        %span.text-subtle
          %i.ph.ph-files
          = @pr_review.files_changed
          files
      - if @pr_review.additions
        %span.text-positive
          +#{@pr_review.additions}
      - if @pr_review.deletions
        %span.text-negative
          \-#{@pr_review.deletions}
- if @pr_review.summary.present?
  .card.mbe-4
    %h2.font-bold.text-sm.mbe-2.text-subtle Summary
    %p.text-sm= @pr_review.summary
= turbo_stream_from @stream_name
#pr_analysis_container
  - if @analysis
    = render "pr_reviews/analysis", analysis: @analysis, cc_command: @cc_command, repo: @pr_review.repo, pr_number: @pr_review.pr_number
  - elsif @job_running
    #pr_analysis_status.card.text-center.p-4{"data-controller" => "analysis-stream"}
      .text-4xl.text-accent.animate-spin.mbe-4
        %i.ph.ph-spinner
      %p.text-sm.text-subtle Analysis in progress…
    %pre#pr_analysis_stream.card.text-sm.p-4.whitespace-pre-wrap.font-mono.max-bs-120.bg-secondary{"data-analysis-stream-target" => "stream", :hidden => ""}
  - elsif !@claude_configured || !@github_configured
    .card.text-center.p-4.text-subtle
      %p.text-sm
        %i.ph.ph-info
        Configure Claude and GitHub to enable analysis.
