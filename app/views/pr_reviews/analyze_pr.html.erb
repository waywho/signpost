<% content_for(:title, "PR Analysis — ##{@pr_number} — Tech Lead OS") %>

<div style="margin-block-end: var(--size-4)">
  <%= link_to pr_reviews_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> PR Reviews
  <% end %>
</div>

<div class="flex items-center justify-between mbe-4">
  <h1 class="font-bold text-2xl">
    <span style="color: var(--color-text-subtle)">#<%= @pr_number %></span>
    <%= @pr_title || "PR Analysis" %>
  </h1>
  <div class="flex items-center gap-half">
    <% if @repo && @pr_number %>
      <%= link_to new_pr_review_path(repo: @repo, pr_number: @pr_number, pr_title: @pr_title, pr_author: @pr_author),
            class: "btn btn--primary text-sm" do %>
        <i class="ph ph-pencil-line"></i> Log Review
      <% end %>
    <% end %>
  </div>
</div>

<% if @error %>
  <div class="alert alert--negative mbe-4">
    <p class="text-sm"><i class="ph ph-warning"></i> Analysis failed: <%= @error %></p>
  </div>
<% elsif @analysis %>
  <%= render "analysis", analysis: @analysis, cc_command: @cc_command %>
<% end %>
