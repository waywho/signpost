<% content_for(:title, "PR Analysis — ##{@pr_number} — Tech Lead OS") %>

<div mbe-4>
  <%= link_to pr_reviews_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> PR Reviews
  <% end %>
</div>

<div class="flex items-center justify-between mbe-4">
  <h1 class="font-bold text-2xl">
    <span style="color: var(--color-text-subtle)">#<%= @pr_number %></span>
    <%= @pr_title || "PR Analysis" %>
  </h1>
</div>

<%= turbo_frame_tag "pr_analysis_result",
      src: run_analysis_pr_reviews_path(repo: @repo, pr_number: @pr_number, pr_title: @pr_title, pr_author: @pr_author),
      loading: :lazy do %>
  <div class="card text-center p-4">
    <i class="ph ph-spinner" style="font-size: var(--text-4xl); display: block; mbe-4; color: var(--color-primary); animation: spin 1s linear infinite"></i>
    <p class="text-sm" style="color: var(--color-text-subtle)">Fetching PR diff and running analysis...</p>
    <p class="text-xs mbs-2" style="color: var(--color-text-subtle)">This may take 10-30 seconds for large PRs.</p>
  </div>
<% end %>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
