<% content_for(:title, "##{@pr_review.pr_number} — PR Reviews — Tech Lead OS") %>

<div class="mbe-4">
  <%= link_to pr_reviews_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> PR Reviews
  <% end %>
</div>

<div class="card mbe-4">
  <div class="flex items-center gap mbe-2">
    <% if @pr_review.recommendation.present? %>
      <span class="badge <%= recommendation_badge_variant(@pr_review.recommendation) %>"><%= @pr_review.recommendation.tr("_", " ") %></span>
    <% end %>
    <% if @pr_review.risk_level.present? %>
      <span class="badge <%= risk_badge_variant(@pr_review.risk_level) %>"><i class="ph ph-shield-warning"></i> <%= @pr_review.risk_level %></span>
    <% end %>
  </div>
  <div class="flex items-center justify-between mbe-2">
    <h1 class="font-bold text-xl">
      <span style="color: var(--color-text-subtle)">#<%= @pr_review.pr_number %></span>
      <%= @pr_review.pr_title.presence || "(no title)" %>
    </h1>
    <% if @claude_configured && @github_configured %>
      <% if @job_running %>
        <button class="btn btn--borderless" disabled>
          <i class="ph ph-spinner" style="animation: spin 1s linear infinite"></i> Re-analyzing…
        </button>
      <% else %>
        <%= button_to pr_review_analysis_path(@pr_review), method: :post, class: "btn btn--borderless" do %>
          <i class="ph ph-arrow-clockwise"></i> Re-analyze
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="flex items-center gap text-sm" style="color: var(--color-text-subtle)">
    <span><i class="ph ph-git-branch"></i> <%= @pr_review.repo %></span>
    <% if @pr_review.pr_author.present? %><span><i class="ph ph-user"></i> <%= @pr_review.pr_author %></span><% end %>
    <% if @pr_review.reviewed_at %><span><%= @pr_review.reviewed_at.strftime("%b %-d, %Y") %></span><% end %>
  </div>
  <% if @pr_review.files_changed || @pr_review.additions || @pr_review.deletions %>
    <div class="flex items-center gap text-sm mbs-2">
      <% if @pr_review.files_changed %><span style="color: var(--color-text-subtle)"><i class="ph ph-files"></i> <%= @pr_review.files_changed %> files</span><% end %>
      <% if @pr_review.additions %><span style="color: var(--color-positive)">+<%= @pr_review.additions %></span><% end %>
      <% if @pr_review.deletions %><span style="color: var(--color-negative)">-<%= @pr_review.deletions %></span><% end %>
    </div>
  <% end %>
</div>

<% if @pr_review.summary.present? %>
  <div class="card mbe-4">
    <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Summary</h2>
    <p class="text-sm"><%= @pr_review.summary %></p>
  </div>
<% end %>

<%= turbo_stream_from @stream_name %>

<div id="pr_analysis_container">
  <% if @analysis %>
    <%= render "pr_reviews/analysis", analysis: @analysis, cc_command: @cc_command, repo: @pr_review.repo, pr_number: @pr_review.pr_number %>
  <% elsif @job_running %>
    <div id="pr_analysis_status" class="card text-center p-4" data-controller="analysis-stream">
      <div style="font-size: var(--text-4xl); color: var(--color-primary); animation: spin 1s linear infinite; margin-block-end: var(--size-4)">
        <i class="ph ph-spinner"></i>
      </div>
      <p class="text-sm" style="color: var(--color-text-subtle)">Analysis in progress…</p>
    </div>
    <pre id="pr_analysis_stream" class="card text-sm p-4" hidden
         data-analysis-stream-target="stream"
         style="white-space: pre-wrap; font-family: monospace; max-block-size: 30rem; overflow-y: auto; background: var(--color-secondary)"></pre>
  <% elsif !@claude_configured || !@github_configured %>
    <div class="card text-center p-4" style="color: var(--color-text-subtle)">
      <p class="text-sm"><i class="ph ph-info"></i> Configure Claude and GitHub to enable analysis.</p>
    </div>
  <% end %>
</div>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
