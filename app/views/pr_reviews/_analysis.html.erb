<div class="mbs-4">
  <%# Receiving-review reminder %>
  <div class="mbe-4 p-3 bg-secondary rounded-lg">
    <p class="text-xs text-subtle">
      <i class="ph ph-info"></i>
      This is AI analysis — verify before acting. Check suggestions against your codebase. Push back on anything that doesn't fit.
    </p>
  </div>

  <%# Recommendation %>
  <div class="card mbe-4">
    <div class="flex items-center gap mbe-2">
      <span class="badge <%= recommendation_badge_variant(analysis[:recommendation]) %>"><%= analysis[:recommendation]&.tr("_", " ") %></span>
    </div>
    <p class="text-sm"><%= analysis[:recommendation_reason] %></p>
    <% if analysis[:summary].present? %>
      <p class="text-sm mbs-2 text-subtle"><%= analysis[:summary] %></p>
    <% end %>
  </div>

  <%# Critical flags %>
  <% if analysis[:critical_flags]&.any? %>
    <div class="mbe-4">
      <% analysis[:critical_flags].each do |flag| %>
        <div class="card mbe-2" style="border-color: var(--color-negative)">
          <div class="flex items-center gap-half">
            <i class="ph ph-warning-circle text-negative"></i>
            <span class="font-bold text-sm text-negative"><%= flag[:title] %></span>
            <span class="badge badge--negative"><%= flag[:severity] %></span>
          </div>
          <p class="text-sm mbs-1"><%= flag[:detail] %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Solves ticket %>
  <% if analysis[:solves_ticket].present? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle">Solves Ticket?</h3>
      <p class="text-sm"><strong><%= analysis[:solves_ticket][:result] %></strong> — <%= analysis[:solves_ticket][:explanation] %></p>
    </div>
  <% end %>

  <%# Before review tips %>
  <% if analysis[:before_review_tips]&.any? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-compass"></i> Focus Areas</h3>
      <ul class="flex flex-col gap-half p-0">
        <% analysis[:before_review_tips].each do |tip| %><li class="text-sm">• <%= tip %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# Strengths %>
  <% if analysis[:strengths]&.any? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-positive"><i class="ph ph-check-circle"></i> Strengths</h3>
      <ul class="flex flex-col gap-half p-0">
        <% analysis[:strengths].each do |s| %><li class="text-sm">• <%= s %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# Issues by severity %>
  <% %w[critical important minor].each do |severity| %>
    <% items = analysis.dig(:issues, severity.to_sym) %>
    <% next unless items&.any? %>
    <% sev_color = case severity when "critical" then "var(--color-negative)" when "important" then "#f97316" else "var(--color-text-subtle)" end %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2" style="color: <%= sev_color %>"><%= severity.capitalize %> Issues (<%= items.size %>)</h3>
      <% items.each do |item| %>
        <div class="border-be-main pb-2">
          <div class="text-sm font-bold font-mono">
            <% if defined?(repo) && defined?(pr_number) && item[:file].present? %>
              <% gh_url = "https://github.com/#{repo}/pull/#{pr_number}/files#diff-#{Digest::SHA256.hexdigest(item[:file].to_s)}" %>
              <%= link_to "#{item[:file]}#{":#{item[:line]}" if item[:line].present?}", gh_url, target: "_blank", class: "text-accent", style: "text-decoration: none" %>
            <% else %>
              <%= item[:file] %><% if item[:line].present? %>:<%= item[:line] %><% end %>
            <% end %>
          </div>
          <p class="text-sm"><%= item[:issue] %></p>
          <p class="text-xs text-subtle"><strong>Why:</strong> <%= item[:why] %></p>
          <p class="text-xs text-subtle"><strong>Fix:</strong> <%= item[:fix] %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Risk areas, missing tests, performance, security %>
  <% { "Risk Areas" => analysis[:risk_areas], "Missing Tests" => analysis[:missing_tests], "Performance Concerns" => analysis[:performance_concerns], "Security Issues" => analysis[:security_issues] }.each do |title, items| %>
    <% next unless items&.any? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><%= title %></h3>
      <ul class="flex flex-col gap-half p-0">
        <% items.each do |item| %>
          <li class="text-sm">•
            <% if item.is_a?(Hash) && item[:file].present? && defined?(repo) && defined?(pr_number) %>
              <% gh_url = "https://github.com/#{repo}/pull/#{pr_number}/files#diff-#{Digest::SHA256.hexdigest(item[:file].to_s)}" %>
              <%= link_to item[:file], gh_url, target: "_blank", class: "font-mono text-accent" %> (<%= item[:severity] %>): <%= item[:reason] %>
            <% elsif item.is_a?(Hash) %>
              <%= "#{item[:file]} (#{item[:severity]}): #{item[:reason]}" %>
            <% else %>
              <%= item %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Inline tips %>
  <% if analysis[:inline_tips]&.any? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-lightbulb"></i> Per-File Tips</h3>
      <% analysis[:inline_tips].each do |tip| %>
        <div class="border-be-main pb-2">
          <div class="text-sm font-bold font-mono">
            <% if tip[:file].present? && defined?(repo) && defined?(pr_number) %>
              <% gh_url = "https://github.com/#{repo}/pull/#{pr_number}/files#diff-#{Digest::SHA256.hexdigest(tip[:file].to_s)}" %>
              <%= link_to tip[:file], gh_url, target: "_blank", class: "text-accent" %>
            <% else %>
              <%= tip[:file] %>
            <% end %>
          </div>
          <p class="text-sm"><%= tip[:tip] %></p>
          <p class="text-xs text-subtle"><em>Why:</em> <%= tip[:why] %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Draft comment %>
  <% if analysis[:draft_comment].present? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-chat-text"></i> Draft Comment</h3>
      <pre class="text-sm p-3 whitespace-pre-wrap bg-secondary rounded-lg" style="font-family: inherit"><%= analysis[:draft_comment] %></pre>
    </div>
  <% end %>

  <%# After checklist %>
  <% if analysis[:after_checklist]&.any? %>
    <div class="card mbe-4">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-check-square"></i> Pre-Submit Checklist</h3>
      <% analysis[:after_checklist].each do |item| %>
        <div class="flex gap pb-1 border-be-main">
          <input type="checkbox" class="flex-item-no-shrink" style="margin-block-start: 0.125rem">
          <div>
            <p class="text-sm"><%= item[:item] %></p>
            <p class="text-xs text-subtle"><%= item[:why] %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Claude Code command %>
  <% if cc_command.present? %>
    <div class="card">
      <h3 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-terminal"></i> Deep Review (Claude Code)</h3>
      <p class="text-xs mbe-2 text-subtle">Run in your terminal for deeper analysis using local codebase + CLAUDE.md</p>
      <pre class="text-xs p-3 whitespace-pre-wrap font-mono bg-secondary rounded-lg"><%= cc_command %></pre>
    </div>
  <% end %>
</div>
