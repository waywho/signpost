<% content_for(:title, "Status — Tech Lead OS") %>

<h1 class="text-2xl font-bold mb-6">System Status</h1>

<div class="grid gap-4 max-w-lg">
  <% @checks.each do |name, check| %>
    <div class="flex items-center justify-between p-4 rounded-lg border
                <%= check[:status] == :ok ? 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-950' : 'border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950' %>">
      <div class="flex items-center gap-3">
        <i class="ti ti-<%= check[:status] == :ok ? 'circle-check text-green-600' : 'alert-circle text-red-600' %> text-xl"></i>
        <span class="font-medium capitalize"><%= name.to_s.tr('_', ' ') %></span>
      </div>
      <span class="text-sm text-gray-600 dark:text-gray-400"><%= check[:detail] %></span>
    </div>
  <% end %>
</div>

<p class="mt-6 text-sm text-gray-500">
  <i class="ti ti-clock"></i>
  Checked at <%= Time.current.strftime("%H:%M:%S") %>
</p>
