<% content_for(:title, "Status — Tech Lead OS") %>

<h1 class="font-bold text-2xl">System Status</h1>

<div class="flex flex-col gap">
  <% @checks.each do |name, check| %>
    <div class="card flex items-center justify-between">
      <div class="flex items-center gap">
        <% if check[:status] == :ok %>
          <i class="ph ph-check-circle text-positive text-xl"></i>
        <% else %>
          <i class="ph ph-warning-circle text-negative text-xl"></i>
        <% end %>
        <span class="font-medium capitalize"><%= name.to_s.tr('_', ' ') %></span>
      </div>
      <span class="text-sm text-subtle"><%= check[:detail] %></span>
    </div>
  <% end %>
</div>

<p class="text-sm text-subtle">
  <i class="ph ph-clock"></i>
  Checked at <%= Time.current.strftime("%H:%M:%S") %>
</p>
