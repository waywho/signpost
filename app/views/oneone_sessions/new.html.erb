<% content_for(:title, "Log 1:1 — #{@developer.name} — Tech Lead OS") %>

<div class="container" style="max-inline-size: 40rem; margin-block-start: var(--size-6)">
  <div style="margin-block-end: var(--size-4)">
    <%= link_to developer_path(@developer), class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
      <i class="ph ph-caret-left"></i> <%= @developer.name %>
    <% end %>
  </div>

  <h1 class="font-bold text-2xl" style="margin-block-end: var(--size-6)">Log 1:1 Session</h1>

  <div class="card">
    <%= form_with model: [@developer, @oneone_session], class: "flex flex-col gap" do |f| %>
      <% if @oneone_session.errors.any? %>
        <div class="alert alert--negative">
          <ul class="text-sm">
            <% @oneone_session.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :session_date, class: "text-sm font-bold", style: "display: block; margin-block-end: var(--size-1)" %>
        <%= f.date_field :session_date, class: "input", required: true %>
      </div>

      <% %i[discussed wins challenges growth action_items].each do |field| %>
        <div>
          <%= f.label field, field.to_s.humanize, class: "text-sm font-bold", style: "display: block; margin-block-end: var(--size-1)" %>
          <%= f.text_area field, class: "input", rows: 3 %>
        </div>
      <% end %>

      <div>
        <%= f.label :private_notes, class: "text-sm font-bold", style: "display: block; margin-block-end: var(--size-1)" %>
        <%= f.text_area :private_notes, class: "input", rows: 3, placeholder: "Private — not shared with the developer" %>
      </div>

      <div>
        <%= f.label :summary, class: "text-sm font-bold", style: "display: block; margin-block-end: var(--size-1)" %>
        <%= f.text_area :summary, class: "input", rows: 2 %>
      </div>

      <div class="flex items-center gap" style="margin-block-start: var(--size-2)">
        <%= f.submit "Save 1:1 Session", class: "button" %>
        <%= link_to "Cancel", developer_path(@developer), class: "button button--ghost" %>
      </div>
    <% end %>
  </div>
</div>
