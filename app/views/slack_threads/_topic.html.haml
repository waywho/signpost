.card.mbe-2{:id => "topic_#{topic.id}"}
  .flex.items-center.gap-half.mbe-2
    %span.font-bold.text-sm.flex-1= topic.title
    - if topic.urgency.present?
      %span{class: "badge #{urgency_badge_variant(topic.urgency)}", data: { tooltip: badge_tooltip(:urgency) }.compact}= topic.urgency
    - if topic.category.present?
      %span.badge{data: { tooltip: badge_tooltip(:category) }.compact}= topic.category
    - if topic.action_recommendation.present?
      %span.badge{data: { tooltip: badge_tooltip(:recommendation) }.compact}
        %i.ph.ph-arrow-right
        = topic.action_recommendation.tr("_", " ")
  %p.text-sm.mbe-2= topic.summary
  - if topic.drafting?
    .flex.items-center.gap-half.mbs-2.p-2.text-subtle
      %i.ph.ph-spinner.animate-spin.inline-block
      %span.text-sm Drafting ticket…
  - elsif topic.status != "open"
    - linked_delegation = (defined?(delegation) && delegation.present?) ? delegation : topic.delegation
    - issue_urls = topic.action_items.where.not(github_issue_url: nil).pluck(:github_issue_url).uniq
    - if linked_delegation || issue_urls.any?
      .flex.items-center.gap-half.flex-wrap.mbs-2
        - if linked_delegation
          = link_to delegation_path(linked_delegation), class: "btn btn--borderless text-sm text-accent" do
            %i.ph.ph-arrow-bend-up-right
            = linked_delegation.summary.truncate(50)
          %span.badge.badge--positive{data: { tooltip: badge_tooltip(:status) }.compact}= linked_delegation.status.tr("_", " ")
        - issue_urls.each do |url|
          = link_to url, target: "_blank", class: "btn btn--borderless text-sm text-accent" do
            %i.ph.ph-github-logo
            = url.split("/").last(2).join("/")
    - else
      %span.badge.badge--positive.mis-2{data: { tooltip: badge_tooltip(:status) }.compact}
        %i.ph.ph-check-circle
        = topic.status
  - else
    .flex.items-center.gap.mbs-2
      = button_to slack_thread_slack_topic_ticket_draft_path(topic.slack_thread, topic), method: :post, class: "btn btn--borderless text-sm text-accent" do
        %i.ph.ph-ticket
        Draft Ticket
      = link_to new_delegation_path(thread_id: topic.slack_thread.id, slack_topic_id: topic.id), class: "btn btn--borderless", data: { turbo: false } do
        %i.ph.ph-arrow-bend-up-right
        Delegate
      = button_to slack_thread_slack_topic_path(topic.slack_thread, topic), method: :patch, params: { status: "actioned" }, class: "btn btn--borderless text-sm text-subtle" do
        %i.ph.ph-check
        Resolve
      = button_to slack_thread_slack_topic_path(topic.slack_thread, topic), method: :patch, params: { status: "dismissed" }, class: "btn btn--borderless text-sm text-subtle" do
        %i.ph.ph-x
        Dismiss
