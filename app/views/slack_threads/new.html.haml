- content_for(:title, "Log Thread — Tech Lead OS")
.container.mbs-6.max-i-form
  .mbe-4
    = link_to slack_threads_path, class: "flex items-center gap-half text-sm text-subtle" do
      %i.ph.ph-caret-left
      All Threads
  %h1.font-bold.text-2xl.mbe-6 Log Slack Thread
  .card
    = form_with model: @slack_thread, class: "flex flex-col gap", data: { controller: "thread-form" } do |f|
      - if @slack_thread.errors.any?
        .alert.alert--negative
          %ul.text-sm
            - @slack_thread.errors.full_messages.each do |msg|
              %li= msg
      %div
        = f.label :slack_url, "Slack Thread URL", class: "text-sm font-bold mbe-1 block"
        = f.url_field :slack_url, class: "input", placeholder: "https://workspace.slack.com/archives/C.../p...", data: { "thread-form-target": "slackUrl", action: "input->thread-form#parseUrl" }
        %p.text-xs.mbs-1.text-subtle Paste a Slack link to auto-fill channel ID and timestamp.
      .flex.gap
        .flex-1
          = f.label :slack_channel_id, "Channel ID *", class: "text-sm font-bold mbe-1 block"
          = f.text_field :slack_channel_id, class: "input", placeholder: "C04XXXXXXX", data: { "thread-form-target": "channelId" }
        .flex-1
          = f.label :slack_channel_name, "Channel Name", class: "text-sm font-bold mbe-1 block"
          = f.text_field :slack_channel_name, class: "input", placeholder: "engineering"
      %div
        = f.label :slack_thread_ts, "Thread Timestamp *", class: "text-sm font-bold mbe-1 block"
        = f.text_field :slack_thread_ts, class: "input", placeholder: "1716566400.000001", data: { "thread-form-target": "threadTs" }
      %div
        = f.label :title, class: "text-sm font-bold mbe-1 block"
        = f.text_field :title, class: "input"
      %div
        = f.label :category, class: "text-sm font-bold mbe-1 block"
        = f.select :category, [["—", ""], ["Architecture", "architecture"], ["Stakeholder", "stakeholder"], ["Team Decision", "team_decision"], ["Incident", "incident"], ["Other", "other"]], {}, class: "input"
      %div
        = f.label :summary, class: "text-sm font-bold mbe-1 block"
        = f.text_area :summary, class: "input", rows: 4
      %div
        %label.text-sm.font-bold.mbe-1.block
          Keywords
          %span.font-normal.text-subtle (comma-separated)
        = text_field_tag :keywords_raw, @slack_thread.keywords&.join(", "), class: "input", placeholder: "postgres, migration"
      %div
        %label.text-sm.font-bold.mbe-1.block
          Participants
          %span.font-normal.text-subtle (comma-separated)
        = text_field_tag :participants_raw, @slack_thread.participants&.join(", "), class: "input", placeholder: "@alice, @bob"
      .flex.items-center.gap
        = f.submit "Log Thread", class: "btn btn--primary"
        = link_to "Cancel", slack_threads_path, class: "btn btn--borderless"
