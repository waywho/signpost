<% content_for(:title, "#{@slack_thread.title.presence || 'Thread'} — Tech Lead OS") %>

<div class="mbe-4">
  <%= link_to slack_threads_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)", data: {turbo_frame: "_top"} do %>
    <i class="ph ph-caret-left"></i> All Threads
  <% end %>
</div>

<%= turbo_frame_tag "offcanvas" do %>
  <%= render "thread_detail", slack_thread: @slack_thread, topics: @topics, messages: @messages,
              analyses: @analyses, repo_paths: @repo_paths,
              developers: @developers, github_repos: @github_repos %>
<% end %>
