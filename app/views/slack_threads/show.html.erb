<% content_for(:title, "#{@slack_thread.title.presence || 'Thread'} — Tech Lead OS") %>

<div class="mbe-4">
  <%= link_to slack_threads_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> All Threads
  <% end %>
</div>

<%# Action bar %>
<%= render "action_bar", thread: @slack_thread %>

<%# Codebase Analysis %>
<%= render "codebase_analyses/trigger", slack_thread: @slack_thread, repo_paths: @repo_paths %>
<% @analyses.each do |analysis| %>
  <%= render "codebase_analyses/analysis_card", analysis:, developers: @developers, github_repos: @github_repos %>
<% end %>

<%# Thread header %>
<div class="card mbe-4">
  <div class="flex items-center gap-half mbe-2">
    <i class="ph <%= category_icon(@slack_thread.category) %>" style="font-size: var(--text-xl); color: var(--color-primary)"></i>
    <h1 class="font-bold text-2xl" style="flex: 1"><%= @slack_thread.title.presence || "Untitled" %></h1>
    <span class="badge <%= status_badge_variant(@slack_thread.status) %>"><%= @slack_thread.status %></span>
    <% if @slack_thread.category.present? %>
      <span class="badge"><%= @slack_thread.category %></span>
    <% end %>
  </div>
  <div class="flex items-center gap text-sm" style="color: var(--color-text-subtle)">
    <% if @slack_thread.slack_channel_name.present? %><span><i class="ph ph-hash"></i> <%= @slack_thread.slack_channel_name %></span><% end %>
    <% if @slack_thread.captured_at %><span><i class="ph ph-clock"></i> <%= @slack_thread.captured_at.strftime("%B %-d, %Y") %></span><% end %>
    <% if @slack_thread.capture_reason.present? %><span><i class="ph ph-lightning"></i> <%= @slack_thread.capture_reason.tr("_", " ") %></span><% end %>
    <% if @slack_thread.slack_url.present? %>
      <%= link_to @slack_thread.slack_url, target: "_blank", style: "color: var(--color-primary)" do %>
        <i class="ph ph-arrow-square-out"></i> Open in Slack
      <% end %>
    <% end %>
  </div>
</div>

<%# Summary %>
<% if @slack_thread.summary.present? %>
  <div class="card mbe-4">
    <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Summary</h2>
    <p class="text-sm"><%= @slack_thread.summary %></p>
  </div>
<% end %>

<%# Topics %>
<% if @topics.any? %>
  <div class="mbe-4">
    <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">
      <i class="ph ph-list-checks"></i> Topics (<%= @topics.size %>)
    </h2>
    <% @topics.each do |topic| %>
      <%= render "topic", topic: topic %>
    <% end %>
  </div>
<% end %>

<%# Participants + Keywords %>
<div class="flex gap mbe-4">
  <% if @slack_thread.participants.present? %>
    <div class="card" style="flex: 1">
      <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)"><i class="ph ph-users"></i> Participants</h2>
      <div class="flex items-center gap-half" style="flex-wrap: wrap">
        <% @slack_thread.participants.each do |p| %><span class="text-xs" style="background: var(--color-secondary); padding: 0.125rem 0.5rem; border-radius: var(--rounded-full)"><%= p %></span><% end %>
      </div>
    </div>
  <% end %>
  <% if @slack_thread.keywords.present? %>
    <div class="card" style="flex: 1">
      <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)"><i class="ph ph-tag"></i> Keywords</h2>
      <div class="flex items-center gap-half" style="flex-wrap: wrap">
        <% @slack_thread.keywords.each do |kw| %><%= link_to kw, slack_threads_path(q: kw), class: "text-xs", style: "background: var(--color-secondary); padding: 0.125rem 0.5rem; border-radius: var(--rounded-full)" %><% end %>
      </div>
    </div>
  <% end %>
</div>

<%# Messages from SlackMessage model %>
<% if @messages.any? %>
  <div class="card" data-controller="thread-messages">
    <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
      <i class="ph ph-chat-dots"></i> Messages (<%= @messages.size %>)
    </h2>
    <% @messages.first(5).each do |msg| %>
      <div class="flex gap" style="padding-block: var(--size-2); border-block-start: 1px solid var(--color-border)">
        <div style="flex-shrink: 0; inline-size: 2rem; block-size: 2rem; background: var(--color-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center">
          <i class="ph ph-user text-xs"></i>
        </div>
        <div style="flex: 1; min-inline-size: 0">
          <div class="flex items-center gap-half mbe-1">
            <span class="font-bold text-sm"><%= msg.user_name || msg.user_id || "Unknown" %></span>
            <% if msg.message_ts_at %><span class="text-xs" style="color: var(--color-text-subtle)"><%= msg.message_ts_at.strftime("%-m/%-d %H:%M") %></span><% end %>
          </div>
          <p class="text-sm" style="white-space: pre-wrap; word-break: break-word"><%= msg.content %></p>
        </div>
      </div>
    <% end %>
    <% if @messages.size > 5 %>
      <div data-thread-messages-target="overflow" style="display: none">
        <% @messages.drop(5).each do |msg| %>
          <div class="flex gap" style="padding-block: var(--size-2); border-block-start: 1px solid var(--color-border)">
            <div style="flex-shrink: 0; inline-size: 2rem; block-size: 2rem; background: var(--color-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center">
              <i class="ph ph-user text-xs"></i>
            </div>
            <div style="flex: 1; min-inline-size: 0">
              <div class="flex items-center gap-half mbe-1">
                <span class="font-bold text-sm"><%= msg.user_name || msg.user_id || "Unknown" %></span>
                <% if msg.message_ts_at %><span class="text-xs" style="color: var(--color-text-subtle)"><%= msg.message_ts_at.strftime("%-m/%-d %H:%M") %></span><% end %>
              </div>
              <p class="text-sm" style="white-space: pre-wrap; word-break: break-word"><%= msg.content %></p>
            </div>
          </div>
        <% end %>
      </div>
      <button class="text-sm mbs-2" style="color: var(--color-primary)" data-action="click->thread-messages#showAll" data-thread-messages-target="toggle">
        Show <%= @messages.size - 5 %> more
      </button>
    <% end %>
  </div>
<% elsif @slack_thread.raw_messages.present? %>
  <%# Fallback to raw_messages JSONB for manually logged threads %>
  <div class="card" data-controller="thread-messages">
    <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
      <i class="ph ph-chat-dots"></i> Messages (<%= @slack_thread.raw_messages.size %>)
    </h2>
    <% @slack_thread.raw_messages.first(5).each do |msg| %>
      <%= render "message", msg: msg %>
    <% end %>
    <% if @slack_thread.raw_messages.size > 5 %>
      <div data-thread-messages-target="overflow" style="display: none">
        <% @slack_thread.raw_messages.drop(5).each do |msg| %>
          <%= render "message", msg: msg %>
        <% end %>
      </div>
      <button class="text-sm mbs-2" style="color: var(--color-primary)" data-action="click->thread-messages#showAll" data-thread-messages-target="toggle">
        Show <%= @slack_thread.raw_messages.size - 5 %> more
      </button>
    <% end %>
  </div>
<% end %>
