<div class="flex gap pb-2 border-bs-main">
  <div class="icon-circle">
    <i class="ph ph-user text-xs"></i>
  </div>
  <div class="flex-1 min-i-0">
    <div class="flex items-center gap-half mbe-1">
      <span class="font-bold text-sm"><%= msg["user"] || msg["username"] || "Unknown" %></span>
      <% if msg["ts"].present? %>
        <span class="text-xs text-subtle"><%= Time.at(msg["ts"].to_f).strftime("%-m/%-d %H:%M") rescue msg["ts"] %></span>
      <% end %>
    </div>
    <p class="text-sm whitespace-pre-wrap break-words"><%= msg["text"] %></p>
  </div>
</div>
