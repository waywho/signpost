<% content_for(:title, "Log Thread — Tech Lead OS") %>

<div class="container mbs-6 max-i-form">
  <div class="mbe-4">
    <%= link_to slack_threads_path, class: "flex items-center gap-half text-sm text-subtle" do %>
      <i class="ph ph-caret-left"></i> All Threads
    <% end %>
  </div>

  <h1 class="font-bold text-2xl mbe-6">Log Slack Thread</h1>

  <div class="card">
    <%= form_with model: @slack_thread, class: "flex flex-col gap", data: { controller: "thread-form" } do |f| %>
      <% if @slack_thread.errors.any? %>
        <div class="alert alert--negative">
          <ul class="text-sm"><% @slack_thread.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
        </div>
      <% end %>

      <div>
        <%= f.label :slack_url, "Slack Thread URL", class: "text-sm font-bold mbe-1 block" %>
        <%= f.url_field :slack_url, class: "input", placeholder: "https://workspace.slack.com/archives/C.../p...",
              data: { "thread-form-target": "slackUrl", action: "input->thread-form#parseUrl" } %>
        <p class="text-xs mbs-1 text-subtle">Paste a Slack link to auto-fill channel ID and timestamp.</p>
      </div>

      <div class="flex gap">
        <div class="flex-1">
          <%= f.label :slack_channel_id, "Channel ID *", class: "text-sm font-bold mbe-1 block" %>
          <%= f.text_field :slack_channel_id, class: "input", placeholder: "C04XXXXXXX", data: { "thread-form-target": "channelId" } %>
        </div>
        <div class="flex-1">
          <%= f.label :slack_channel_name, "Channel Name", class: "text-sm font-bold mbe-1 block" %>
          <%= f.text_field :slack_channel_name, class: "input", placeholder: "engineering" %>
        </div>
      </div>

      <div>
        <%= f.label :slack_thread_ts, "Thread Timestamp *", class: "text-sm font-bold mbe-1 block" %>
        <%= f.text_field :slack_thread_ts, class: "input", placeholder: "1716566400.000001", data: { "thread-form-target": "threadTs" } %>
      </div>

      <div><%= f.label :title, class: "text-sm font-bold mbe-1 block" %><%= f.text_field :title, class: "input" %></div>

      <div>
        <%= f.label :category, class: "text-sm font-bold mbe-1 block" %>
        <%= f.select :category, [["—", ""], ["Architecture", "architecture"], ["Stakeholder", "stakeholder"], ["Team Decision", "team_decision"], ["Incident", "incident"], ["Other", "other"]], {}, class: "input" %>
      </div>

      <div><%= f.label :summary, class: "text-sm font-bold mbe-1 block" %><%= f.text_area :summary, class: "input", rows: 4 %></div>

      <div>
        <label class="text-sm font-bold mbe-1 block">Keywords <span class="font-normal text-subtle">(comma-separated)</span></label>
        <input type="text" name="keywords_raw" class="input" placeholder="postgres, migration" value="<%= @slack_thread.keywords&.join(', ') %>">
      </div>

      <div>
        <label class="text-sm font-bold mbe-1 block">Participants <span class="font-normal text-subtle">(comma-separated)</span></label>
        <input type="text" name="participants_raw" class="input" placeholder="@alice, @bob" value="<%= @slack_thread.participants&.join(', ') %>">
      </div>

      <div class="flex items-center gap"><%= f.submit "Log Thread", class: "btn btn--primary" %><%= link_to "Cancel", slack_threads_path, class: "btn btn--borderless" %></div>
    <% end %>
  </div>
</div>
