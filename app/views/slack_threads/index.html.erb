<% content_for(:title, "Slack Threads — Tech Lead OS") %>

<div class="flex items-center justify-between mbe-4">
  <h1 class="font-bold text-2xl">Slack Threads</h1>
  <%= link_to new_slack_thread_path, class: "btn btn--primary" do %><i class="ph ph-plus"></i> Log Thread<% end %>
</div>

<%# Status tabs %>
<div class="flex items-center gap-half mbe-4">
  <% current_status = params[:status] || "new_thread" %>
  <% [["New", "new_thread"], ["Triaged", "triaged"], ["Actioned", "actioned"], ["Archived", "archived"], ["All", "all"]].each do |label, status| %>
    <% active = current_status == status %>
    <% count = status == "all" ? @status_counts.values.sum : (@status_counts[status] || 0) %>
    <%= link_to slack_threads_path(status: status, category: params[:category], q: params[:q]),
          class: "text-sm #{active ? 'font-bold' : 'text-subtle'}" do %>
      <%= label %><% if count > 0 && status != "all" %> <span class="text-xs">(<%= count %>)</span><% end %>
    <% end %>
  <% end %>
</div>

<%# Category + search %>
<div class="flex items-center gap mbe-4 flex-wrap">
  <div class="flex items-center gap-half">
    <%= link_to "All categories", slack_threads_path(status: params[:status] || "new_thread", q: params[:q]),
          class: "text-sm #{params[:category].blank? ? 'font-bold' : 'text-subtle'}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat, slack_threads_path(status: params[:status] || "new_thread", category: cat, q: params[:q]),
            class: "text-sm #{params[:category] == cat ? 'font-bold' : 'text-subtle'}" %>
    <% end %>
  </div>

  <%= form_with url: slack_threads_path, method: :get, class: "flex items-center gap-half",
        data: { controller: "thread-filter", action: "submit->thread-filter#submit" } do |f| %>
    <%= hidden_field_tag :status, params[:status] || "new_thread" %>
    <%= hidden_field_tag :category, params[:category] %>
    <%= f.search_field :q, value: params[:q], placeholder: "Search…", class: "input min-i-64",
          data: { "thread-filter-target": "input", action: "input->thread-filter#scheduleSubmit" } %>
  <% end %>
</div>

<%# Thread list %>
<% if @slack_threads.any? %>
  <div class="flex flex-col gap">
    <% @slack_threads.each do |thread| %>
      <div id="<%= dom_id(thread) %>" class="card flex items-center gap">
        <%= link_to slack_thread_path(thread), class: "flex items-center gap flex-1 min-i-0", style: "text-decoration: none" do %>
          <i class="ph <%= category_icon(thread.category) %> text-xl text-accent flex-item-no-shrink"></i>
          <div class="flex flex-col flex-1 min-i-0">
            <div class="flex items-center gap-half">
              <span class="font-bold text-sm"><%= thread.title.presence || "Untitled" %></span>
              <% urgency = highest_urgency(thread) %>
              <% if urgency %>
                <span class="badge <%= urgency_badge_variant(urgency) %>"><%= urgency %></span>
              <% end %>
              <% if thread.slack_topics.any? %>
                <span class="text-xs text-subtle"><%= thread.slack_topics.size %> topics</span>
              <% end %>
            </div>
            <% if thread.summary.present? %>
              <span class="text-xs overflow-ellipsis text-subtle"><%= thread.summary.truncate(80) %></span>
            <% end %>
            <div class="flex items-center gap-half text-xs text-subtle">
              <% if thread.slack_channel_name.present? %><span><i class="ph ph-hash"></i> <%= thread.slack_channel_name %></span><% end %>
              <% if thread.capture_reason.present? %><span><%= thread.capture_reason.tr("_", " ") %></span><% end %>
              <span><%= thread.captured_at&.strftime("%b %-d") %></span>
            </div>
          </div>
        <% end %>

        <% if thread.status.in?(%w[new_thread triaged]) %>
          <div class="flex items-center gap-half flex-item-no-shrink">
            <%= button_to slack_thread_acknowledgement_path(thread), method: :post, class: "btn btn--positive btn--icon btn--borderless", title: "Acknowledge" do %>
              <i class="ph ph-check"></i>
            <% end %>
            <%= button_to slack_thread_dismissal_path(thread), method: :post, class: "btn btn--icon btn--borderless", title: "Dismiss" do %>
              <i class="ph ph-x"></i>
            <% end %>
          </div>
        <% else %>
          <span class="badge <%= status_badge_variant(thread.status) %>"><%= thread.status %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card text-center text-subtle">
    <i class="ph ph-chat-dots mbe-4 text-4xl block"></i>
    <p>No threads found.</p>
    <% if params[:q].present? || params[:category].present? || (params[:status] || "new_thread") != "new_thread" %>
      <p class="text-sm mbs-2"><%= link_to "Clear filters", slack_threads_path %></p>
    <% end %>
  </div>
<% end %>
