<% if thread.status.in?(%w[new_thread triaged]) %>
  <div class="card flex items-center gap mbe-4">
    <span class="text-sm font-bold" style="flex: 1">
      <i class="ph ph-tray"></i> Triage
    </span>
    <%= button_to slack_thread_acknowledgement_path(thread), method: :post, class: "btn btn--primary" do %>
      <i class="ph ph-check"></i> Acknowledge
    <% end %>
    <%= link_to new_delegation_path(thread_id: thread.id), class: "btn btn--primary", data: { turbo: false } do %>
      <i class="ph ph-arrow-bend-up-right"></i> Delegate
    <% end %>
    <%= button_to slack_thread_dismissal_path(thread), method: :post, class: "btn btn--borderless" do %>
      <i class="ph ph-x"></i> Dismiss
    <% end %>
    <% if thread.slack_url.present? %>
      <%= link_to thread.slack_url, target: "_blank", class: "btn btn--borderless" do %>
        <i class="ph ph-arrow-square-out"></i> Open in Slack
      <% end %>
    <% end %>
  </div>
<% end %>
