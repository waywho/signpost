<%= turbo_stream_from slack_thread %>

<%# Action bar %>
<%= render "action_bar", thread: slack_thread %>

<%# Codebase Analysis %>
<%= render "codebase_analyses/trigger", slack_thread:, repo_paths: %>
<% analyses.each do |analysis| %>
  <%= render "codebase_analyses/analysis_card", analysis:, developers:, github_repos: %>
<% end %>

<%# Thread header %>
<div class="card mbe-4">
  <div class="flex items-center gap-half mbe-2">
    <i class="ph <%= category_icon(slack_thread.category) %> text-xl text-accent"></i>
    <h1 class="font-bold text-2xl flex-1"><%= slack_thread.title.presence || "Untitled" %></h1>
    <%= button_to slack_thread_triage_path(slack_thread), method: :post, class: "btn btn--borderless text-xs" do %>
      <i class="ph ph-arrow-clockwise"></i> Triage
    <% end %>
    <span class="badge <%= status_badge_variant(slack_thread.status) %>"><%= slack_thread.status %></span>
    <% if slack_thread.category.present? %>
      <span class="badge"><%= slack_thread.category %></span>
    <% end %>
  </div>
  <div class="flex items-center gap text-sm text-subtle">
    <% if slack_thread.slack_channel_name.present? %><span><i class="ph ph-hash"></i> <%= slack_thread.slack_channel_name %></span><% end %>
    <% if slack_thread.captured_at %><span><i class="ph ph-clock"></i> <%= slack_thread.captured_at.strftime("%B %-d, %Y") %></span><% end %>
    <% if slack_thread.capture_reason.present? %><span><i class="ph ph-lightning"></i> <%= slack_thread.capture_reason.tr("_", " ") %></span><% end %>
    <% if slack_thread.slack_url.present? %>
      <%= link_to slack_thread.slack_url, target: "_blank", class: "text-accent" do %>
        <i class="ph ph-arrow-square-out"></i> Open in Slack
      <% end %>
    <% end %>
  </div>
</div>

<%# Summary %>
<% if slack_thread.summary.present? %>
  <div class="card mbe-4">
    <h2 class="font-bold text-sm mbe-2 text-subtle">Summary</h2>
    <p class="text-sm"><%= slack_thread.summary %></p>
  </div>
<% end %>

<%# Topics %>
<% if topics.any? %>
  <div class="mbe-4">
    <div class="flex items-center justify-between mbe-2">
      <h2 class="font-bold text-sm text-subtle">
        <i class="ph ph-list-checks"></i> Topics (<%= topics.size %>)
      </h2>
    </div>
    <% if topics.size > 1 %>
      <%= form_with url: slack_thread_topic_merge_path(slack_thread), method: :post, class: "mbe-2" do |f| %>
        <% topics.each do |topic| %>
          <div class="flex items-start gap-half mbe-2">
            <input type="checkbox" name="topic_ids[]" value="<%= topic.id %>" class="input mbs-1 flex-item-no-shrink">
            <div class="flex-1">
              <%= render "topic", topic: %>
            </div>
          </div>
        <% end %>
        <%= f.submit "Merge Selected Topics", class: "btn btn--borderless text-xs" %>
      <% end %>
    <% else %>
      <% topics.each do |topic| %>
        <%= render "topic", topic: %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# Participants + Keywords %>
<div class="flex gap mbe-4">
  <% if slack_thread.participants.present? %>
    <div class="card flex-1">
      <h2 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-users"></i> Participants</h2>
      <div class="flex items-center gap-half flex-wrap">
        <% slack_thread.participants.each do |p| %><span class="text-xs" style="background: var(--color-secondary); padding: 0.125rem 0.5rem; border-radius: var(--rounded-full)"><%= p %></span><% end %>
      </div>
    </div>
  <% end %>
  <% if slack_thread.keywords.present? %>
    <div class="card flex-1">
      <h2 class="font-bold text-sm mbe-2 text-subtle"><i class="ph ph-tag"></i> Keywords</h2>
      <div class="flex items-center gap-half flex-wrap">
        <% slack_thread.keywords.each do |kw| %><%= link_to kw, slack_threads_path(q: kw), class: "text-xs", style: "background: var(--color-secondary); padding: 0.125rem 0.5rem; border-radius: var(--rounded-full)" %><% end %>
      </div>
    </div>
  <% end %>
</div>

<%# Messages from SlackMessage model %>
<% if messages.any? %>
  <div class="card" data-controller="thread-messages">
    <h2 class="font-bold text-sm mbe-4 text-subtle">
      <i class="ph ph-chat-dots"></i> Messages (<%= messages.size %>)
    </h2>
    <% messages.first(5).each do |msg| %>
      <div class="flex gap pb-2 border-bs-main">
        <div class="icon-circle">
          <i class="ph ph-user text-xs"></i>
        </div>
        <div class="flex-1 min-i-0">
          <div class="flex items-center gap-half mbe-1">
            <span class="font-bold text-sm"><%= msg.user_name || msg.user_id || "Unknown" %></span>
            <% if msg.message_ts_at %><span class="text-xs text-subtle"><%= msg.message_ts_at.strftime("%-m/%-d %H:%M") %></span><% end %>
          </div>
          <p class="text-sm whitespace-pre-wrap break-words"><%= msg.content %></p>
        </div>
      </div>
    <% end %>
    <% if messages.size > 5 %>
      <div data-thread-messages-target="overflow" class="hidden">
        <% messages.drop(5).each do |msg| %>
          <div class="flex gap pb-2 border-bs-main">
            <div class="icon-circle">
              <i class="ph ph-user text-xs"></i>
            </div>
            <div class="flex-1 min-i-0">
              <div class="flex items-center gap-half mbe-1">
                <span class="font-bold text-sm"><%= msg.user_name || msg.user_id || "Unknown" %></span>
                <% if msg.message_ts_at %><span class="text-xs text-subtle"><%= msg.message_ts_at.strftime("%-m/%-d %H:%M") %></span><% end %>
              </div>
              <p class="text-sm whitespace-pre-wrap break-words"><%= msg.content %></p>
            </div>
          </div>
        <% end %>
      </div>
      <button class="text-sm mbs-2 text-accent" data-action="click->thread-messages#showAll" data-thread-messages-target="toggle">
        Show <%= messages.size - 5 %> more
      </button>
    <% end %>
  </div>
<% elsif slack_thread.raw_messages.present? %>
  <%# Fallback to raw_messages JSONB for manually logged threads %>
  <div class="card" data-controller="thread-messages">
    <h2 class="font-bold text-sm mbe-4 text-subtle">
      <i class="ph ph-chat-dots"></i> Messages (<%= slack_thread.raw_messages.size %>)
    </h2>
    <% slack_thread.raw_messages.first(5).each do |msg| %>
      <%= render "message", msg: msg %>
    <% end %>
    <% if slack_thread.raw_messages.size > 5 %>
      <div data-thread-messages-target="overflow" class="hidden">
        <% slack_thread.raw_messages.drop(5).each do |msg| %>
          <%= render "message", msg: msg %>
        <% end %>
      </div>
      <button class="text-sm mbs-2 text-accent" data-action="click->thread-messages#showAll" data-thread-messages-target="toggle">
        Show <%= slack_thread.raw_messages.size - 5 %> more
      </button>
    <% end %>
  </div>
<% end %>
