<%= turbo_stream.replace "oneone_prep" do %>
  <div id="oneone_prep" class="card mbe-4">
    <h2 class="font-bold text-sm mbe-4 text-subtle">
      <i class="ph ph-brain"></i> 1:1 Prep Briefing
    </h2>
    <% if @error %>
      <p class="text-sm text-negative"><i class="ph ph-warning"></i> <%= @error %></p>
    <% else %>
      <div class="text-sm whitespace-pre-wrap leading-relaxed"><%= @briefing %></div>
    <% end %>
  </div>
<% end %>
