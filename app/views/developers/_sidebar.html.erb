<div class="sidebar-menu">
  <div class="flex items-center justify-between p-2">
    <span class="font-bold text-sm">Developers</span>
    <%= link_to new_developer_path, class: "text-sm text-accent" do %>
      <i class="ph ph-plus"></i> Add
    <% end %>
  </div>

  <% developers.each do |dev| %>
    <%= link_to developer_path(dev),
          class: "sidebar-menu__button btn #{dev == current_dev ? 'active' : ''}",
          aria: { current: dev == current_dev ? 'page' : nil } do %>
      <div class="avatar" style="--avatar-size: var(--size-8); background-color: <%= dev.color.presence || 'var(--color-border)' %>">
        <span role="img"><%= dev.name.split.map(&:first).first(2).join.upcase %></span>
      </div>
      <div class="flex flex-col flex-1 min-i-0">
        <span class="text-sm font-medium overflow-ellipsis"><%= dev.name %></span>
        <span class="text-xs text-subtle"><%= dev.role %></span>
      </div>
      <% if dev.developer_notes.any? { |n| n.note_type == "concern" } %>
        <i class="ph ph-warning text-negative flex-item-no-shrink"></i>
      <% end %>
    <% end %>
  <% end %>
</div>
