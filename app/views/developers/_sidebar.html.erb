<div class="sidebar-menu">
  <div class="flex items-center justify-between" style="padding: var(--size-2)">
    <span class="font-bold text-sm">Developers</span>
    <%= link_to new_developer_path, class: "text-sm", style: "color: var(--color-primary)" do %>
      <i class="ph ph-plus"></i> Add
    <% end %>
  </div>

  <% developers.each do |dev| %>
    <%= link_to developer_path(dev),
          class: "sidebar-menu__button btn #{dev == current_dev ? 'active' : ''}",
          aria: { current: dev == current_dev ? 'page' : nil } do %>
      <div class="developer-avatar" style="background-color: <%= dev.color.presence || 'var(--color-border)' %>">
        <%= dev.name.split.map(&:first).first(2).join.upcase %>
      </div>
      <div class="flex flex-col flex-1" style="min-inline-size: 0">
        <span class="text-sm font-medium overflow-ellipsis"><%= dev.name %></span>
        <span class="text-xs" style="color: var(--color-text-subtle)"><%= dev.role %></span>
      </div>
      <% if dev.developer_notes.any? { |n| n.note_type == "concern" } %>
        <i class="ph ph-warning" style="color: var(--color-negative); flex-shrink: 0"></i>
      <% end %>
    <% end %>
  <% end %>
</div>
