<% content_for(:title, "#{@developer.name} — Tech Lead OS") %>
<% content_for(:body_class, "sidebar-layout") %>

<div id="sidebar">
  <%= render "sidebar", developers: Developer.by_name.includes(:developer_notes), current_dev: @developer %>
</div>

<div id="main">
  <div class="container">
    <div class="flex items-center justify-between mbe-6">
      <h1 class="font-bold text-2xl"><%= @developer.name %></h1>
      <div class="flex items-center gap-half">
        <%= link_to edit_developer_path(@developer), class: "text-sm", style: "color: var(--color-text-subtle)" do %>
          <i class="ph ph-pencil"></i> Edit
        <% end %>
        <%= button_to developer_path(@developer), method: :delete, class: "btn btn--negative btn--borderless text-sm",
              data: { turbo_confirm: "Remove #{@developer.name}?" } do %>
          <i class="ph ph-trash"></i> Delete
        <% end %>
      </div>
    </div>

    <%# Profile info %>
    <div class="card mbe-4">
      <dl class="flex flex-col gap-half">
        <% { "Role" => @developer.role, "Level" => @developer.level, "GitHub" => @developer.github_handle, "Slack" => @developer.slack_handle, "Joined" => @developer.joined_team&.strftime("%B %Y") }.each do |label, value| %>
          <% next unless value.present? %>
          <div class="flex items-center gap">
            <dt class="text-sm font-bold" style="min-inline-size: 6rem"><%= label %></dt>
            <dd class="text-sm"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% if @developer.strengths.present? %>
      <div class="card mbe-4">
        <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Strengths</h2>
        <p class="text-sm"><%= @developer.strengths %></p>
      </div>
    <% end %>

    <% if @developer.growth_areas.present? %>
      <div class="card mbe-4">
        <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Growth Areas</h2>
        <p class="text-sm"><%= @developer.growth_areas %></p>
      </div>
    <% end %>

    <% if @developer.career_goals.present? %>
      <div class="card mbe-4">
        <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Career Goals</h2>
        <p class="text-sm"><%= @developer.career_goals %></p>
      </div>
    <% end %>

    <% if @developer.skills.present? && @developer.skills.any? %>
      <div class="card mbe-4">
        <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Skills</h2>
        <div class="flex flex-col gap-half">
          <% @developer.skills.each do |skill| %>
            <% skill = skill.is_a?(Hash) ? skill : {} %>
            <div class="flex items-center gap">
              <span class="text-sm flex-1"><%= skill["name"] || skill[:name] %></span>
              <div class="flex gap-half">
                <% rating = (skill["rating"] || skill[:rating] || 0).to_i %>
                <% 5.times do |i| %>
                  <i class="ph <%= i < rating ? 'ph-star-fill' : 'ph-star' %>" style="color: <%= i < rating ? 'var(--color-primary)' : 'var(--color-border)' %>"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render "github_activity", developer: @developer, activities: @github_activities %>

    <%# Notes section %>
    <div class="card mbe-4">
      <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
        <i class="ph ph-note"></i> Observations
      </h2>

      <%= turbo_frame_tag "new_note_form" do %>
        <%= form_with model: [@developer, @developer_note], class: "flex items-center gap mbe-4" do |f| %>
          <%= f.select :note_type, [["Good", "good"], ["Growth", "growth"], ["Concern", "concern"], ["Context", "context"]], {}, class: "input", style: "max-inline-size: 8rem" %>
          <%= f.text_field :content, placeholder: "Add observation...", class: "input flex-1" %>
          <%= f.submit "Add", class: "btn btn--primary" %>
        <% end %>
      <% end %>

      <div id="notes_list">
        <% @notes.each do |note| %>
          <%= render "developer_notes/note", note: note %>
        <% end %>
      </div>
    </div>

    <%# 1:1 Prep %>
    <turbo-frame id="oneone_prep">
      <% if @claude_configured %>
        <div class="card mbe-4">
          <%= button_to prep_developer_path(@developer), method: :post, class: "btn btn--primary", data: { turbo_frame: "oneone_prep" } do %>
            <i class="ph ph-brain"></i> Prep 1:1
          <% end %>
          <p class="text-xs mbs-2" style="color: var(--color-text-subtle)">
            Generate talking points from recent notes, activity, and last 1:1.
          </p>
        </div>
      <% end %>
    </turbo-frame>

    <%# 1:1 Sessions section %>
    <div class="card">
      <div class="flex items-center justify-between mbe-4">
        <h2 class="font-bold text-sm" style="color: var(--color-text-subtle)">
          <i class="ph ph-chats"></i> 1:1 Sessions
        </h2>
        <%= link_to new_developer_oneone_session_path(@developer), class: "text-sm", style: "color: var(--color-primary)" do %>
          <i class="ph ph-plus"></i> Log 1:1
        <% end %>
      </div>

      <% if @oneone_sessions.any? %>
        <div class="flex flex-col gap-half">
          <% @oneone_sessions.each do |session| %>
            <%= link_to developer_oneone_session_path(@developer, session), class: "flex items-center gap card", style: "text-decoration: none" do %>
              <div class="flex flex-col flex-1">
                <span class="font-medium text-sm"><%= session.session_date.strftime("%B %-d, %Y") %></span>
                <% if session.summary.present? %>
                  <span class="text-xs overflow-ellipsis" style="color: var(--color-text-subtle)"><%= session.summary.truncate(80) %></span>
                <% end %>
              </div>
              <i class="ph ph-caret-right" style="color: var(--color-text-subtle)"></i>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-center" style="color: var(--color-text-subtle)">No 1:1 sessions yet.</p>
      <% end %>
    </div>
  </div>
</div>
