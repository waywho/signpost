<div id="action_item_<%= item.id %>" class="card mbe-3">
  <div class="flex gap" style="align-items: flex-start">
    <%# Left: info %>
    <div class="flex-1" style="min-inline-size: 0">
      <div class="flex items-center gap-half mbe-2">
        <%= urgency_badge(item.slack_topic.urgency) %>

        <span class="font-bold text-sm flex-1"><%= item.slack_topic.title %></span>
        <% if item.slack_thread.slack_url.present? %>
          <%= link_to item.slack_thread.slack_url, target: "_blank", class: "text-xs", style: "color: var(--color-text-subtle)" do %>
            <i class="ph ph-arrow-square-out"></i> Slack
          <% end %>
        <% end %>
      </div>

      <p class="text-sm mbe-3" style="color: var(--color-text-subtle)"><%= item.slack_topic.summary %></p>

      <div class="flex items-center gap text-xs mbe-3" style="color: var(--color-text-subtle)">
        <% if item.suggested_developer %>
          <span><i class="ph ph-user"></i> <%= item.suggested_developer.name %></span>
          <% if item.suggestion_reason.present? %>
            <span>(<%= item.suggestion_reason %>)</span>
          <% end %>
        <% end %>
        <% if item.suggested_repo.present? %>
          <span><i class="ph ph-git-branch"></i> <%= item.suggested_repo %></span>
        <% end %>
      </div>

      <% if item.related_items.present? && item.related_items.any? %>
        <div class="mbe-3">
          <span class="badge">Related:</span>
          <% item.related_items.each do |related| %>
            <div class="text-xs mbs-1" style="color: var(--color-text-subtle)">
              <% if related["thread_id"] %>
                <%= link_to slack_thread_path(related["thread_id"]), style: "text-decoration: none" do %>
                  <%= related["title"] || "Thread" %> (<%= ((related["similarity"] || 0) * 100).round %>% match)
                <% end %>
              <% else %>
                <%= related["title"] %> (<%= ((related["similarity"] || 0) * 100).round %>% match)
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if item.draft_title.present? %>
        <details class="mbe-3">
          <summary class="text-xs font-bold" style="color: var(--color-text-subtle); cursor: pointer">
            <i class="ph ph-file-text"></i> Draft: <%= item.draft_title %>
          </summary>
          <div class="text-sm mbs-2 p-3" style="white-space: pre-wrap; background: var(--color-secondary); border-radius: var(--rounded-lg)"><%= item.draft_body %></div>
        </details>
      <% end %>
    </div>

    <%# Right: actions %>
    <div style="min-inline-size: 16rem; max-inline-size: 18rem">
      <%= form_with url: action_item_action_path(item), method: :post, id: "act_form_#{item.id}",
            class: "flex flex-col gap-half",
            data: { controller: "ticket-option" } do |f| %>
        <%= f.collection_select :developer_id, developers, :id, :name,
              { selected: item.suggested_developer_id, include_blank: "— unassigned —" },
              class: "input text-xs" %>
        <% if github_repos.any? %>
          <%= f.select :repo, github_repos.map { |r| [r, r] },
                { selected: item.suggested_repo }, class: "input text-xs" %>
        <% end %>
        <label class="flex items-center gap-half text-xs">
          <input type="checkbox" name="notify_thread" value="1" class="input">
          <i class="ph ph-chat-circle"></i> Notify on thread
        </label>
        <label class="flex items-center gap-half text-xs">
          <input type="checkbox" name="create_issue" value="1" class="input"
                 <%= "checked" if item.action_type == "create_ticket" %>
                 data-ticket-option-target="createCheckbox"
                 data-action="ticket-option#createChanged">
          <i class="ph ph-github-logo"></i> Create GitHub issue
        </label>
        <input type="url" name="existing_issue_url" placeholder="Or paste issue URL…"
               class="input text-xs"
               data-ticket-option-target="existingUrl"
               data-action="input->ticket-option#urlChanged">
      <% end %>
      <div class="flex items-center gap-half mbs-1">
        <button type="submit" form="act_form_<%= item.id %>" class="btn btn--primary text-xs">Do it</button>
        <%= button_to action_item_path(item), method: :patch, params: { status: "resolved" }, class: "btn btn--borderless text-xs" do %>
          <i class="ph ph-check-circle"></i> Resolved
        <% end %>
        <%= button_to action_item_path(item), method: :patch, params: { status: "dismissed" }, class: "btn btn--borderless text-xs" do %>
          <i class="ph ph-x"></i> Dismiss
        <% end %>
      </div>
    </div>
  </div>
</div>
