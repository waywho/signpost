<% if ignored_count > 0 %>
  <details class="mbe-4">
    <summary class="text-sm" style="color: var(--color-text-subtle); cursor: pointer">
      <i class="ph ph-eye-slash"></i> <%= ignored_count %> topic<%= "s" if ignored_count != 1 %> auto-ignored
    </summary>
    <div class="flex flex-col gap-half mbs-2">
      <% if ignored_items.present? %>
        <% ignored_items.each do |item| %>
          <div class="flex items-center justify-between py-1" style="border-block-end: 1px solid var(--color-border)">
            <span class="text-sm" style="color: var(--color-text-subtle)"><%= item.slack_topic.title %></span>
            <%= button_to action_item_path(item), method: :patch, params: { status: "pending" }, class: "btn btn--secondary text-xs" do %>
              Restore
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs" style="color: var(--color-text-subtle)">
          <%= link_to "Load ignored items", root_path(show_ignored: true) %>
        </p>
      <% end %>
    </div>
  </details>
<% end %>
