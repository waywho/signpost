<div id="action_item_<%= item.id %>" class="flex items-center justify-between py-1" style="border-block-end: 1px solid var(--color-border)">
  <div class="flex items-center gap-half">
    <span class="badge badge--secondary text-xs"><%= item.slack_topic.slack_thread&.slack_channel_name %></span>
    <span class="text-sm"><%= item.slack_topic.title %></span>
  </div>
  <div class="flex items-center gap-half">
    <%= button_to action_item_path(item), method: :patch, params: { status: "resolved" }, class: "btn btn--icon btn--borderless", title: "Resolved" do %>
      <i class="ph ph-check-circle"></i>
    <% end %>
    <%= button_to action_item_path(item), method: :patch, params: { status: "dismissed" }, class: "btn btn--icon btn--borderless", title: "Dismiss" do %>
      <i class="ph ph-x"></i>
    <% end %>
  </div>
</div>
