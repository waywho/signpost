<div id="action_item_<%= item.id %>" class="card p-3 mbe-2">
  <div class="flex items-center justify-between mbe-1">
    <div class="flex items-center gap-half">
      <span class="badge badge--primary text-xs">Discuss</span>
      <span class="badge badge--secondary text-xs"><%= item.slack_topic.slack_thread&.slack_channel_name %></span>
    </div>
    <div class="flex items-center gap-half">
      <% if item.slack_topic.slack_thread&.slack_url.present? %>
        <a href="<%= item.slack_topic.slack_thread.slack_url %>" target="_blank" class="btn btn--icon btn--borderless" title="Open in Slack">
          <i class="ph ph-chat-teardrop-dots"></i>
        </a>
      <% end %>
      <%= button_to action_item_path(item), method: :patch, params: { status: "resolved" }, class: "btn btn--icon btn--borderless", title: "Resolved" do %>
        <i class="ph ph-check-circle"></i>
      <% end %>
      <%= button_to action_item_path(item), method: :patch, params: { status: "dismissed" }, class: "btn btn--icon btn--borderless", title: "Dismiss" do %>
        <i class="ph ph-x"></i>
      <% end %>
    </div>
  </div>
  <p class="font-bold text-sm"><%= item.slack_topic.title %></p>
  <p class="text-xs text-subtle"><%= item.slack_topic.summary %></p>
  <% if item.slack_thread %>
    <%= link_to slack_thread_path(item.slack_thread, anchor: "topic_#{item.slack_topic_id}"), class: "text-xs text-subtle", data: { turbo_frame: "_top" } do %>
      <i class="ph ph-chat-dots"></i> <%= item.slack_thread.title.presence || "Thread" %>
    <% end %>
  <% end %>
</div>
