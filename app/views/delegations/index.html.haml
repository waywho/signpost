- content_for(:title, "Delegations — Vane")
.flex.items-center.justify-between.mbe-4
  %h1.font-bold.text-2xl Delegations
  = link_to new_delegation_path, class: "btn btn--primary" do
    %i.ph.ph-plus
    New Delegation
.flex.items-center.gap-half.mbe-4
  - [["All active", nil], ["Delegated", "delegated"], ["In Progress", "in_progress"], ["Blocked", "blocked"], ["Done", "done"]].each do |label, status|
    - active = params[:status] == status || (status.nil? && params[:status].blank?)
    = link_to label, delegations_path(status: status), class: "text-sm #{active ? 'font-bold' : 'text-subtle'}"
- if @delegations.any?
  .flex.flex-col.gap
    - @delegations.each do |d|
      = link_to delegation_path(d), class: "card flex items-center gap", style: "text-decoration: none" do
        - if d.urgency.present?
          %span{:class => "badge #{urgency_badge_variant(d.urgency)} min-i-16"}= d.urgency
        .flex.flex-col.flex-1.min-i-0
          %span.font-bold.text-sm= d.summary.truncate(60)
          %span.text-xs.text-subtle= d.developer&.name || d.developer_name || "Unassigned"
        - delegation_badge = { "blocked" => "badge--negative", "done" => "badge--positive", "in_progress" => "badge--primary" }[d.status] || ""
        %span{:class => "badge #{delegation_badge}"}= d.status.tr("_", " ")
- else
  .card.text-center.text-subtle
    %i.ph.ph-clipboard.mbe-4.text-4xl.block
    %p No delegations found.
