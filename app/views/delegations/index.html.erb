<% content_for(:title, "Delegations — Tech Lead OS") %>

<div class="flex items-center justify-between" style="margin-block-end: var(--size-4)">
  <h1 class="font-bold text-2xl">Delegations</h1>
  <%= link_to new_delegation_path, class: "btn btn--primary" do %>
    <i class="ph ph-plus"></i> New Delegation
  <% end %>
</div>

<div class="flex items-center gap-half" style="margin-block-end: var(--size-4)">
  <% [["All active", nil], ["Delegated", "delegated"], ["In Progress", "in_progress"], ["Blocked", "blocked"], ["Done", "done"]].each do |label, status| %>
    <% active = params[:status] == status || (status.nil? && params[:status].blank?) %>
    <%= link_to label, delegations_path(status: status), class: "text-sm #{active ? 'font-bold' : ''}", style: active ? '' : 'color: var(--color-text-subtle)' %>
  <% end %>
</div>

<% if @delegations.any? %>
  <div class="flex flex-col gap">
    <% @delegations.each do |d| %>
      <%= link_to delegation_path(d), class: "card flex items-center gap", style: "text-decoration: none" do %>
        <% if d.urgency.present? %>
          <%
            urg_color = case d.urgency
                        when "Critical" then "var(--color-negative)"
                        when "High" then "#f97316"
                        when "Medium" then "var(--color-primary)"
                        else "var(--color-text-subtle)"
                        end
          %>
          <span class="text-xs font-bold" style="color: <%= urg_color %>; min-inline-size: 4rem"><%= d.urgency %></span>
        <% end %>
        <div class="flex flex-col flex-1" style="min-inline-size: 0">
          <span class="font-bold text-sm"><%= d.summary.truncate(60) %></span>
          <span class="text-xs" style="color: var(--color-text-subtle)"><%= d.developer&.name || d.developer_name || "Unassigned" %></span>
        </div>
        <%
          status_color = case d.status
                         when "blocked" then "var(--color-negative)"
                         when "done" then "var(--color-positive)"
                         when "in_progress" then "var(--color-primary)"
                         else "var(--color-text-subtle)"
                         end
        %>
        <span class="text-xs font-bold" style="color: <%= status_color %>"><%= d.status.tr("_", " ") %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card text-center" style="color: var(--color-text-subtle)">
    <i class="ph ph-clipboard" style="font-size: var(--text-4xl); display: block; margin-block-end: var(--size-4)"></i>
    <p>No delegations found.</p>
  </div>
<% end %>
