<% content_for(:title, "Delegations — Tech Lead OS") %>

<div class="flex items-center justify-between mbe-4">
  <h1 class="font-bold text-2xl">Delegations</h1>
  <%= link_to new_delegation_path, class: "btn btn--primary" do %>
    <i class="ph ph-plus"></i> New Delegation
  <% end %>
</div>

<div class="flex items-center gap-half mbe-4">
  <% [["All active", nil], ["Delegated", "delegated"], ["In Progress", "in_progress"], ["Blocked", "blocked"], ["Done", "done"]].each do |label, status| %>
    <% active = params[:status] == status || (status.nil? && params[:status].blank?) %>
    <%= link_to label, delegations_path(status: status), class: "text-sm #{active ? 'font-bold' : 'text-subtle'}" %>
  <% end %>
</div>

<% if @delegations.any? %>
  <div class="flex flex-col gap">
    <% @delegations.each do |d| %>
      <%= link_to delegation_path(d), class: "card flex items-center gap", style: "text-decoration: none" do %>
        <% if d.urgency.present? %>
          <span class="badge <%= urgency_badge_variant(d.urgency) %> min-i-16"><%= d.urgency %></span>
        <% end %>
        <div class="flex flex-col flex-1 min-i-0">
          <span class="font-bold text-sm"><%= d.summary.truncate(60) %></span>
          <span class="text-xs text-subtle"><%= d.developer&.name || d.developer_name || "Unassigned" %></span>
        </div>
        <%
          delegation_badge = case d.status
                             when "blocked" then "badge--negative"
                             when "done" then "badge--positive"
                             when "in_progress" then "badge--primary"
                             else ""
                             end
        %>
        <span class="badge <%= delegation_badge %>"><%= d.status.tr("_", " ") %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card text-center text-subtle">
    <i class="ph ph-clipboard mbe-4 text-4xl block"></i>
    <p>No delegations found.</p>
  </div>
<% end %>
