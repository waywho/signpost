<% content_for(:title, "#{@delegation.summary.truncate(30)} — Delegations — Tech Lead OS") %>

<div class="mbe-4">
  <%= link_to delegations_path, class: "flex items-center gap-half text-sm", style: "color: var(--color-text-subtle)" do %>
    <i class="ph ph-caret-left"></i> Delegations
  <% end %>
</div>

<div class="flex items-center justify-between mbe-6">
  <h1 class="font-bold text-2xl"><%= @delegation.summary %></h1>
  <div class="flex items-center gap-half">
    <%= link_to edit_delegation_path(@delegation), class: "text-sm" do %><i class="ph ph-pencil"></i> Edit<% end %>
    <%= button_to delegation_path(@delegation), method: :delete, class: "btn btn--negative btn--borderless text-sm", data: { turbo_confirm: "Delete this delegation?" } do %>
      <i class="ph ph-trash"></i> Delete
    <% end %>
  </div>
</div>

<div class="card mbe-4">
  <dl class="flex flex-col gap-half">
    <% { "Developer" => @delegation.developer&.name || @delegation.developer_name, "Urgency" => @delegation.urgency, "Status" => @delegation.status&.tr("_", " "), "Issue Type" => @delegation.issue_type, "Delegated" => @delegation.delegated_at&.strftime("%B %-d, %Y"), "Resolved" => @delegation.resolved_at&.strftime("%B %-d, %Y") }.each do |label, value| %>
      <% next unless value.present? %>
      <div class="flex items-center gap">
        <dt class="text-sm font-bold" style="min-inline-size: 6rem"><%= label %></dt>
        <dd class="text-sm"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</div>

<% if @delegation.handoff_message.present? %>
  <div class="card mbe-4">
    <h2 class="font-bold text-sm mbe-2" style="color: var(--color-text-subtle)">Handoff Message</h2>
    <p class="text-sm" style="white-space: pre-wrap"><%= @delegation.handoff_message %></p>
  </div>
<% end %>

<% if @delegation.github_issue_url.present? %>
  <p class="text-sm mbe-4">
    <i class="ph ph-github-logo"></i>
    <%= link_to @delegation.github_issue_url, @delegation.github_issue_url, target: "_blank" %>
  </p>
<% end %>

<% github_repos = Setting.get("global", "github_repos", default: []) %>
<% if @delegation.github_issue_url.blank? && GitHubService.new.configured? && github_repos.any? %>
  <div class="card mbe-4">
    <span class="text-sm font-bold mbe-2" style="display: block">
      <i class="ph ph-github-logo"></i> Create GitHub Issue
    </span>
    <%= form_with url: create_issue_delegation_path(@delegation), method: :post, class: "flex items-center gap" do |f| %>
      <%= f.select :repo, github_repos.map { |r| [r, r] },
            { include_blank: "— select repo —" }, class: "input" %>
      <%= f.submit "Create Issue", class: "btn btn--primary" %>
    <% end %>
  </div>
<% end %>

<div class="card">
  <span class="text-sm font-bold mbe-2" style="display: block">Update Status</span>
  <div class="flex items-center gap-half">
    <% %w[delegated in_progress done blocked].each do |s| %>
      <% if s == @delegation.status %>
        <span class="btn font-bold"><%= s.tr("_", " ") %></span>
      <% else %>
        <%= button_to delegation_path(@delegation), method: :patch, params: { delegation: { status: s } }, class: "btn btn--borderless text-sm" do %>
          <%= s.tr("_", " ") %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
