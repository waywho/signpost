<div id="codebase_analysis_<%= analysis.id %>" class="card mbe-3">
  <div class="flex items-center gap-half mbe-2">
    <i class="ph ph-magnifying-glass-plus" style="color: var(--color-primary)"></i>
    <span class="font-bold text-sm flex-1">Analysis: <%= analysis.repo_name %></span>
    <span class="badge <%= analysis.completed? ? 'badge--positive' : analysis.failed? ? 'badge--negative' : 'badge--secondary' %>">
      <%= analysis.status %>
    </span>
  </div>

  <% case analysis.status %>
  <% when "pending", "running" %>
    <div data-controller="analysis-polling"
         data-analysis-polling-url-value="<%= slack_thread_codebase_analysis_path(analysis.slack_thread, analysis) %>"
         data-analysis-polling-interval-value="5000">
      <turbo-frame id="codebase_analysis_frame_<%= analysis.id %>">
        <div class="flex items-center gap-half p-3" style="color: var(--color-text-subtle)">
          <i class="ph ph-spinner" style="animation: spin 1s linear infinite; display: inline-block"></i>
          <span class="text-sm">
            <%= analysis.running? ? "Claude is investigating #{analysis.repo_name}…" : "Queued for analysis…" %>
          </span>
        </div>
      </turbo-frame>
    </div>

  <% when "completed" %>
    <% if analysis.analysis.present? %>
      <details class="mbe-3">
        <summary class="text-xs font-bold" style="color: var(--color-text-subtle); cursor: pointer">
          <i class="ph ph-article"></i> Full Analysis
        </summary>
        <div class="text-sm mbs-2 p-3" style="white-space: pre-wrap; background: var(--color-secondary); border-radius: var(--rounded-lg); max-block-size: 24rem; overflow-y: auto"><%= analysis.analysis %></div>
      </details>
    <% end %>

    <% if analysis.draft_title.present? %>
      <details open class="mbe-3">
        <summary class="text-xs font-bold" style="color: var(--color-text-subtle); cursor: pointer">
          <i class="ph ph-file-text"></i> Draft: <%= analysis.draft_title %>
        </summary>
        <div class="text-sm mbs-2 p-3" style="white-space: pre-wrap; background: var(--color-secondary); border-radius: var(--rounded-lg)"><%= analysis.draft_body %></div>
      </details>
    <% end %>

    <% if analysis.github_issue_url.present? %>
      <div class="flex items-center gap-half mbe-3 text-xs" style="color: var(--color-positive)">
        <i class="ph ph-check-circle"></i>
        <%= link_to analysis.github_issue_url, analysis.github_issue_url, target: "_blank" %>
      </div>
    <% end %>

    <div class="flex items-center gap-half" style="flex-wrap: wrap">
      <%# Create Issue %>
      <% unless analysis.github_issue_url.present? %>
        <%= form_with url: create_issue_slack_thread_codebase_analysis_path(analysis.slack_thread, analysis),
              method: :post, class: "flex items-center gap-half" do |f| %>
          <% if github_repos.any? %>
            <%= f.select :repo, github_repos.map { |r| [r, r] },
                  { selected: analysis.repo_name }, class: "input text-xs" %>
          <% end %>
          <%= f.submit "Create Issue", class: "btn btn--primary text-xs" %>
        <% end %>
      <% end %>

      <%# Delegate %>
      <%= form_with url: delegate_slack_thread_codebase_analysis_path(analysis.slack_thread, analysis),
            method: :post, class: "flex items-center gap-half" do |f| %>
        <%= f.collection_select :developer_id, developers, :id, :name,
              { include_blank: "— assign —" }, class: "input text-xs" %>
        <label class="flex items-center gap-half text-xs">
          <input type="checkbox" name="notify_thread" value="1" class="input">
          <i class="ph ph-chat-circle"></i>
        </label>
        <%= f.submit "Delegate", class: "btn btn--secondary text-xs" %>
      <% end %>

      <%# Re-analyze %>
      <%= form_with url: slack_thread_codebase_analyses_path(analysis.slack_thread),
            method: :post, class: "inline-flex" do |f| %>
        <%= f.hidden_field :repo_name, value: analysis.repo_name %>
        <%= f.submit "Re-analyze", class: "btn btn--borderless text-xs" %>
      <% end %>

      <%# Dismiss %>
      <%= button_to dismiss_slack_thread_codebase_analysis_path(analysis.slack_thread, analysis),
            method: :post, class: "btn btn--borderless text-xs" do %>
        <i class="ph ph-x"></i> Dismiss
      <% end %>
    </div>

  <% when "failed" %>
    <div class="text-sm mbe-3" style="color: var(--color-negative)">
      <i class="ph ph-warning"></i> <%= analysis.error_message %>
    </div>
    <div class="flex items-center gap-half">
      <%= form_with url: slack_thread_codebase_analyses_path(analysis.slack_thread),
            method: :post, class: "inline-flex" do |f| %>
        <%= f.hidden_field :repo_name, value: analysis.repo_name %>
        <%= f.submit "Retry", class: "btn btn--primary text-xs" %>
      <% end %>
      <%= button_to dismiss_slack_thread_codebase_analysis_path(analysis.slack_thread, analysis),
            method: :post, class: "btn btn--borderless text-xs" do %>
        <i class="ph ph-x"></i> Dismiss
      <% end %>
    </div>
  <% end %>
</div>
