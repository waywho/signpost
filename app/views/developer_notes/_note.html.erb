<%
  note_badge = case note.note_type
               when "good" then "badge--positive"
               when "concern" then "badge--negative"
               when "growth" then "badge--primary"
               else ""
               end
%>
<div class="flex gap items-start pb-2 border-be-main">
  <span class="badge <%= note_badge %> min-i-16"><%= note.note_type&.capitalize %></span>
  <p class="text-sm flex-1"><%= note.content %></p>
  <time class="text-xs text-subtle"><%= note.created_at.strftime("%b %-d") %></time>
</div>
