<% content_for(:title, "Settings — Tech Lead OS") %>

<h1 class="font-bold text-2xl mbe-6">Settings</h1>

<%# AI Backend %>
<% ai_backend = Setting.get("global", "ai_backend", default: "cli") %>
<div class="card mbe-6" data-controller="toggle-class" data-toggle-class-css-class-value="hidden">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-brain"></i> AI Backend
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "ai_backend" %>
    <div>
      <label class="text-sm font-bold mbe-1" style="display: block">Backend</label>
      <select name="ai_backend" class="input" onchange="document.getElementById('anthropic-key-field').style.display = this.value === 'api' ? '' : 'none'">
        <% %w[cli api].each do |mode| %>
          <option value="<%= mode %>" <%= 'selected' if ai_backend == mode %>><%= mode == "cli" ? "Claude Code CLI (uses your subscription)" : "Anthropic API (requires API key)" %></option>
        <% end %>
      </select>
      <p class="text-xs mbs-1" style="color: var(--color-text-subtle)">
        <strong>CLI:</strong> Uses your installed <code>claude</code> command. No API key needed.<br>
        <strong>API:</strong> Direct HTTP calls to Anthropic. Requires an API key.
      </p>
    </div>
    <div id="anthropic-key-field" style="<%= 'display: none' unless ai_backend == 'api' %>">
      <label class="text-sm font-bold mbe-1" style="display: block">Anthropic API Key</label>
      <% has_key = EncryptedSetting.get("credentials", "anthropic_api_key").present? %>
      <input type="password" name="anthropic_api_key" value="<%= has_key ? '••••••••' : '' %>"
             class="input" style="inline-size: 100%" placeholder="<%= has_key ? 'Configured' : 'sk-ant-...' %>">
      <p class="text-xs mbs-1" style="color: var(--color-text-subtle)">Get a key at <a href="https://console.anthropic.com/settings/keys" target="_blank">console.anthropic.com</a></p>
    </div>
    <%= f.submit "Save", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>

<%# API Keys %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-key"></i> API Keys
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "api_keys" %>
    <%
      api_keys = {
        "openai_api_key" => { label: "OpenAI API Key", hint: "For vector embeddings (sk-...)" },
        "github_pat" => { label: "GitHub Personal Access Token", hint: "For PR queue, developer activity, issue creation (ghp-...)" },
        "slack_bot_token" => { label: "Slack Bot Token", hint: "For reading channels and events (xoxb-...)" },
        "slack_user_token" => { label: "Slack User Token", hint: "For reacting/replying as you, not the bot (xoxp-...)" },
        "slack_app_token" => { label: "Slack App-Level Token", hint: "For Socket Mode real-time events (xapp-...)" }
      }
    %>
    <% api_keys.each do |key, meta| %>
      <div>
        <label class="text-sm font-bold mbe-1" style="display: block"><%= meta[:label] %></label>
        <% has_value = EncryptedSetting.get("credentials", key).present? %>
        <input type="password" name="<%= key %>" value="<%= has_value ? '••••••••' : '' %>"
               class="input" style="inline-size: 100%" placeholder="<%= has_value ? 'Configured' : 'Not set' %>">
        <p class="text-xs mbs-1" style="color: var(--color-text-subtle)"><%= meta[:hint] %></p>
      </div>
    <% end %>
    <%= f.submit "Save API Keys", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>

<%# GitHub %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-github-logo"></i> GitHub
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "github" %>
    <div>
      <label class="text-sm font-bold mbe-1" style="display: block">Username</label>
      <input type="text" name="github_username" value="<%= Setting.get('global', 'github_username') %>" class="input" placeholder="your-github-handle">
    </div>
    <div>
      <label class="text-sm font-bold mbe-1" style="display: block">Repos <span class="font-normal text-xs" style="color: var(--color-text-subtle)">(comma-separated, for issue creation)</span></label>
      <input type="text" name="github_repos" value="<%= (Setting.get('global', 'github_repos', default: []) || []).join(', ') %>" class="input" style="inline-size: 100%" placeholder="org/repo1, org/repo2">
    </div>
    <%= f.submit "Save GitHub Settings", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>

<%# Slack %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-chat-teardrop-dots"></i> Slack Capture
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "slack" %>
    <div class="flex gap">
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Capture Mode</label>
        <select name="slack_capture_mode" class="input">
          <% %w[socket poll both].each do |mode| %>
            <option value="<%= mode %>" <%= 'selected' if Setting.get('global', 'slack_capture_mode', default: 'both') == mode %>><%= mode %></option>
          <% end %>
        </select>
      </div>
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Brain Emoji</label>
        <input type="text" name="slack_brain_emoji" value="<%= Setting.get('global', 'slack_brain_emoji', default: 'brain') %>" class="input">
      </div>
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Poll Interval (min)</label>
        <input type="number" name="poll_interval_minutes" value="<%= Setting.get('global', 'poll_interval_minutes', default: 15) %>" class="input">
      </div>
    </div>
    <%= f.submit "Save Slack Settings", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>

<%# Watched Channels %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-hash"></i> Watched Channels
  </h2>
  <% if @watched_channels.any? %>
    <div class="flex flex-col gap-half mbe-4">
      <% @watched_channels.each do |ch| %>
        <div class="flex items-center justify-between" style="padding-block: var(--size-1); border-block-end: 1px solid var(--color-border)">
          <div>
            <span class="font-bold text-sm"><%= ch.channel_name %></span>
            <span class="text-xs" style="color: var(--color-text-subtle)"><%= ch.channel_id %> · <%= ch.capture_mode %></span>
          </div>
          <%= button_to settings_path, method: :patch, params: { section: "watched_channel_remove", channel_id: ch.channel_id }, class: "btn btn--negative btn--icon btn--borderless" do %>
            <i class="ph ph-trash"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= form_with url: settings_path, method: :patch, class: "flex items-end gap" do |f| %>
    <%= hidden_field_tag :section, "watched_channel_add" %>
    <div style="flex: 1">
      <label class="text-sm font-bold mbe-1" style="display: block">Channel ID</label>
      <input type="text" name="channel_id" class="input" placeholder="C04XXXXXXX" required>
    </div>
    <div style="flex: 1">
      <label class="text-sm font-bold mbe-1" style="display: block">Channel Name</label>
      <input type="text" name="channel_name" class="input" placeholder="engineering" required>
    </div>
    <div style="flex: 1">
      <label class="text-sm font-bold mbe-1" style="display: block">Capture Mode</label>
      <select name="capture_mode" class="input">
        <option value="full_stream">Full Stream</option>
        <option value="involvement_only">Involvement Only</option>
        <option value="ignored">Ignored</option>
      </select>
    </div>
    <%= f.submit "Add Channel", class: "btn btn--primary" %>
  <% end %>
</div>

<%# Noise Filters %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-funnel"></i> Noise Filters
  </h2>
  <% if @noise_filters.any? %>
    <div class="flex flex-col gap-half mbe-4">
      <% @noise_filters.each do |nf| %>
        <div class="flex items-center justify-between" style="padding-block: var(--size-1); border-block-end: 1px solid var(--color-border)">
          <div>
            <span class="font-bold text-sm"><%= nf.category %></span>
            <span class="text-xs" style="color: var(--color-text-subtle)"><%= nf.description %></span>
          </div>
          <%= button_to settings_path, method: :patch, params: { section: "noise_filter_remove", filter_id: nf.id }, class: "btn btn--negative btn--icon btn--borderless" do %>
            <i class="ph ph-trash"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= form_with url: settings_path, method: :patch, class: "flex items-end gap" do |f| %>
    <%= hidden_field_tag :section, "noise_filter_add" %>
    <div style="flex: 1">
      <label class="text-sm font-bold mbe-1" style="display: block">Category</label>
      <input type="text" name="filter_category" class="input" placeholder="deploy_notification" required>
    </div>
    <div style="flex: 2">
      <label class="text-sm font-bold mbe-1" style="display: block">Description</label>
      <input type="text" name="filter_description" class="input" placeholder="Automated deploy notifications" required>
    </div>
    <%= f.submit "Add Filter", class: "btn btn--primary" %>
  <% end %>
</div>

<%# Calendar %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-calendar"></i> Google Calendar
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "calendar" %>
    <div>
      <label class="text-sm font-bold mbe-1" style="display: block">Secret iCal URL</label>
      <% has_url = EncryptedSetting.get("credentials", "google_ical_url").present? %>
      <input type="url" name="google_ical_url" value="<%= has_url ? '••••••••' : '' %>"
             class="input" style="inline-size: 100%"
             placeholder="<%= has_url ? 'Configured' : 'https://calendar.google.com/calendar/ical/.../basic.ics' %>">
      <p class="text-xs mbs-1" style="color: var(--color-text-subtle)">
        Google Calendar → Settings → calendar → Secret address in iCal format
      </p>
    </div>
    <%= f.submit "Save Calendar URL", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>

<%# Search %>
<div class="card mbe-6">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-magnifying-glass"></i> Search
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex items-end gap" do |f| %>
    <%= hidden_field_tag :section, "search" %>
    <div style="flex: 1">
      <label class="text-sm font-bold mbe-1" style="display: block">Default Similarity Threshold</label>
      <input type="number" name="search_default_threshold" value="<%= Setting.get('global', 'search_default_threshold', default: 0.75) %>" step="0.05" min="0" max="1" class="input">
    </div>
    <%= f.submit "Save", class: "btn btn--primary" %>
  <% end %>
</div>

<%# Compression %>
<div class="card">
  <h2 class="font-bold text-sm mbe-4" style="color: var(--color-text-subtle)">
    <i class="ph ph-archive"></i> Compression & Reanalysis
  </h2>
  <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
    <%= hidden_field_tag :section, "compression" %>
    <div class="flex gap">
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Compress after (months)</label>
        <input type="number" name="compression_after_months" value="<%= Setting.get('global', 'compression_after_months', default: 6) %>" class="input">
      </div>
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Reanalysis threshold (messages)</label>
        <input type="number" name="reanalysis_message_threshold" value="<%= Setting.get('global', 'reanalysis_message_threshold', default: 3) %>" class="input">
      </div>
      <div style="flex: 1">
        <label class="text-sm font-bold mbe-1" style="display: block">Reanalysis quiet period (min)</label>
        <input type="number" name="reanalysis_quiet_minutes" value="<%= Setting.get('global', 'reanalysis_quiet_minutes', default: 30) %>" class="input">
      </div>
    </div>
    <%= f.submit "Save Compression Settings", class: "btn btn--primary", style: "align-self: flex-start" %>
  <% end %>
</div>
