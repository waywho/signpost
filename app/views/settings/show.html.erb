<% content_for(:title, "Settings — Tech Lead OS") %>

<h1 class="font-bold text-2xl mbe-6">Settings</h1>

<div class="flex gap items-start" data-controller="settings-nav">
  <%# Side nav %>
  <nav class="flex flex-col gap-half min-i-48 sticky" style="top: var(--size-4)">
    <%
      sections = [
        { icon: "ph-brain", label: "AI Backend" },
        { icon: "ph-cube", label: "OpenAI" },
        { icon: "ph-github-logo", label: "GitHub" },
        { icon: "ph-chat-teardrop-dots", label: "Slack" },
        { icon: "ph-calendar", label: "Calendar" },
        { icon: "ph-folder-open", label: "Repos" },
        { icon: "ph-magnifying-glass", label: "Search" },
        { icon: "ph-archive", label: "Archive" }
      ]
    %>
    <% sections.each do |section| %>
      <a href="#" class="sidebar-menu__button btn text-sm flex items-center gap-half"
         data-settings-nav-target="link" data-action="settings-nav#select">
        <i class="ph <%= section[:icon] %>"></i> <%= section[:label] %>
      </a>
    <% end %>
  </nav>

  <%# Panels %>
  <div class="flex-1">

    <%# AI Backend %>
    <% ai_backend = Setting.get("global", "ai_backend", default: "cli") %>
    <div data-settings-nav-target="panel" id="ai_backend">
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-brain"></i> AI Backend
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "ai_backend" %>
          <div>
            <label class="text-sm font-bold mbe-1 block">Backend</label>
            <select name="ai_backend" class="input" onchange="document.getElementById('anthropic-key-field').style.display = this.value === 'api' ? '' : 'none'">
              <% %w[cli api].each do |mode| %>
                <option value="<%= mode %>" <%= 'selected' if ai_backend == mode %>><%= mode == "cli" ? "Claude Code CLI (uses your subscription)" : "Anthropic API (requires API key)" %></option>
              <% end %>
            </select>
            <p class="text-xs mbs-1 text-subtle">
              <strong>CLI:</strong> Uses your installed <code>claude</code> command. No API key needed.<br>
              <strong>API:</strong> Direct HTTP calls to Anthropic. Requires an API key.
            </p>
          </div>
          <div id="anthropic-key-field" class="<%= 'hidden' unless ai_backend == 'api' %>" data-controller="password-reveal">
            <div class="flex items-center gap-half mbe-1">
              <label class="text-sm font-bold block">Anthropic API Key</label>
              <% has_key = EncryptedSetting.get("credentials", "anthropic_api_key").present? %>
              <i class="ph <%= has_key ? 'ph-check-circle' : 'ph-circle-dashed' %> status-icon <%= has_key ? 'status-icon--ok' : 'status-icon--pending' %>"></i>
            </div>
            <div class="group">
              <input type="password" name="anthropic_api_key" data-password-reveal-target="input"
                     class="input" placeholder="<%= has_key ? 'Configured — leave blank to keep' : 'sk-ant-...' %>">
              <button type="button" class="btn btn--icon" data-action="password-reveal#toggle" title="Toggle visibility">
                <i class="ph ph-eye" data-password-reveal-target="icon"></i>
              </button>
            </div>
            <p class="text-xs mbs-1 text-subtle">Get a key at <a href="https://console.anthropic.com/settings/keys" target="_blank">console.anthropic.com</a></p>
          </div>
          <%= f.submit "Save", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

    <%# OpenAI %>
    <div data-settings-nav-target="panel" id="api_keys" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-cube"></i> OpenAI
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "api_keys" %>
          <div data-controller="password-reveal">
            <div class="flex items-center gap-half mbe-1">
              <label class="text-sm font-bold block">API Key</label>
              <% has_openai = EncryptedSetting.get("credentials", "openai_api_key").present? %>
              <i class="ph <%= has_openai ? 'ph-check-circle' : 'ph-circle-dashed' %> status-icon <%= has_openai ? 'status-icon--ok' : 'status-icon--pending' %>"></i>
            </div>
            <div class="group">
              <input type="password" name="openai_api_key" data-password-reveal-target="input"
                     class="input" placeholder="<%= has_openai ? 'Configured — leave blank to keep' : 'sk-...' %>">
              <button type="button" class="btn btn--icon" data-action="password-reveal#toggle" title="Toggle visibility">
                <i class="ph ph-eye" data-password-reveal-target="icon"></i>
              </button>
            </div>
            <p class="text-xs mbs-1 text-subtle">For vector embeddings. Get a key at <a href="https://platform.openai.com/api-keys" target="_blank">platform.openai.com</a></p>
          </div>
          <%= f.submit "Save", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

    <%# GitHub %>
    <div data-settings-nav-target="panel" id="github" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-github-logo"></i> GitHub
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "github" %>
          <div data-controller="password-reveal">
            <div class="flex items-center gap-half mbe-1">
              <label class="text-sm font-bold block">Personal Access Token</label>
              <% has_pat = EncryptedSetting.get("credentials", "github_pat").present? %>
              <i class="ph <%= has_pat ? 'ph-check-circle' : 'ph-circle-dashed' %> status-icon <%= has_pat ? 'status-icon--ok' : 'status-icon--pending' %>"></i>
            </div>
            <div class="group">
              <input type="password" name="github_pat" data-password-reveal-target="input"
                     class="input" placeholder="<%= has_pat ? 'Configured — leave blank to keep' : 'ghp-...' %>">
              <button type="button" class="btn btn--icon" data-action="password-reveal#toggle" title="Toggle visibility">
                <i class="ph ph-eye" data-password-reveal-target="icon"></i>
              </button>
            </div>
            <p class="text-xs mbs-1 text-subtle">For PR queue, developer activity, and issue creation</p>
          </div>
          <div>
            <label class="text-sm font-bold mbe-1 block">Username</label>
            <input type="text" name="github_username" value="<%= Setting.get('global', 'github_username') %>" class="input" placeholder="your-github-handle">
          </div>
          <div>
            <label class="text-sm font-bold mbe-2 block">Watched Repos <span class="font-normal text-xs text-subtle">(for issue creation)</span></label>
            <% if @available_repos.any? %>
              <% orgs = @available_repos.map { |r| r[:full_name].split("/").first }.uniq.sort %>
              <div data-controller="repo-filter">
              <% if orgs.size > 1 %>
                <div class="flex items-center gap-half mbe-2">
                  <span class="text-xs text-subtle">Filter:</span>
                  <button type="button" class="badge" data-action="repo-filter#filter" data-repo-filter-org-param="">All</button>
                  <% orgs.each do |org| %>
                    <button type="button" class="badge" data-action="repo-filter#filter" data-repo-filter-org-param="<%= org %>"><%= org %></button>
                  <% end %>
                </div>
              <% end %>
              <div class="flex flex-col gap-half max-bs-80" data-repo-filter-target="list">
                <% @available_repos.each do |repo| %>
                  <label class="flex items-center gap-half text-sm" data-org="<%= repo[:full_name].split('/').first %>">
                    <input type="checkbox" name="github_repos[]" value="<%= repo[:full_name] %>" class="input"
                           <%= 'checked' if @selected_repos.include?(repo[:full_name]) %>>
                    <%= repo[:full_name] %>
                    <% if repo[:private] %>
                      <i class="ph ph-lock text-subtle"></i>
                    <% end %>
                  </label>
                <% end %>
              </div>
              </div>
            <% elsif @github_configured %>
              <p class="text-sm text-subtle">Could not fetch repos. Check your GitHub PAT.</p>
            <% else %>
              <p class="text-sm text-subtle">Save your PAT above and reload to see repos.</p>
            <% end %>
          </div>
          <%= f.submit "Save GitHub Settings", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

    <%# Slack %>
    <%
      slack_keys = {
        "slack_bot_token" => { label: "Bot Token", hint: "For reading channels and events (xoxb-...)" },
        "slack_user_token" => { label: "User Token", hint: "For reacting/replying as you (xoxp-...)" },
        "slack_app_token" => { label: "App-Level Token", hint: "For Socket Mode real-time events (xapp-...)" }
      }
    %>
    <div data-settings-nav-target="panel" id="slack" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-chat-teardrop-dots"></i> Slack
        </h2>

        <%# Tokens %>
        <h3 class="font-bold text-xs mbe-2 text-subtle">Tokens</h3>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap mbe-6" do |f| %>
          <%= hidden_field_tag :section, "slack_tokens" %>
          <% slack_keys.each do |key, meta| %>
            <div data-controller="password-reveal">
              <div class="flex items-center gap-half mbe-1">
                <label class="text-sm font-bold block"><%= meta[:label] %></label>
                <% has_value = EncryptedSetting.get("credentials", key).present? %>
                <i class="ph <%= has_value ? 'ph-check-circle' : 'ph-circle-dashed' %> status-icon <%= has_value ? 'status-icon--ok' : 'status-icon--pending' %>"></i>
              </div>
              <div class="group">
                <input type="password" name="<%= key %>" data-password-reveal-target="input"
                       class="input" placeholder="<%= has_value ? 'Configured — leave blank to keep' : 'Not set' %>">
                <button type="button" class="btn btn--icon" data-action="password-reveal#toggle" title="Toggle visibility">
                  <i class="ph ph-eye" data-password-reveal-target="icon"></i>
                </button>
              </div>
              <p class="text-xs mbs-1 text-subtle"><%= meta[:hint] %></p>
            </div>
          <% end %>
          <%= f.submit "Save Tokens", class: "btn btn--primary self-start" %>
        <% end %>

        <%# Capture Settings %>
        <div class="separator mbe-4"></div>
        <h3 class="font-bold text-xs mbe-2 text-subtle">Capture Settings</h3>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap mbe-6" do |f| %>
          <%= hidden_field_tag :section, "slack" %>
          <div class="flex gap">
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Capture Mode</label>
              <select name="slack_capture_mode" class="input">
                <% %w[socket poll both].each do |mode| %>
                  <option value="<%= mode %>" <%= 'selected' if Setting.get('global', 'slack_capture_mode', default: 'both') == mode %>><%= mode %></option>
                <% end %>
              </select>
            </div>
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Brain Emoji</label>
              <input type="text" name="slack_brain_emoji" value="<%= Setting.get('global', 'slack_brain_emoji', default: 'brain') %>" class="input">
            </div>
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Poll Interval (min)</label>
              <input type="number" name="poll_interval_minutes" value="<%= Setting.get('global', 'poll_interval_minutes', default: 15) %>" class="input">
            </div>
          </div>
          <div class="flex gap">
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Your Slack User ID</label>
              <% slack_user_id = Setting.get("global", "slack_user_id") %>
              <% if slack_user_id.present? %>
                <div class="flex items-center gap-half">
                  <input type="text" value="<%= slack_user_id %>" class="input text-subtle" readonly>
                  <span class="text-xs text-positive"><i class="ph ph-check-circle"></i> Auto-detected</span>
                </div>
                <p class="text-xs mbs-1 text-subtle">Threads you start are skipped during capture.</p>
              <% else %>
                <div class="flex items-center gap-half">
                  <span class="text-xs text-subtle"><i class="ph ph-info"></i> Auto-detected on first capture run</span>
                </div>
              <% end %>
            </div>
          </div>
          <%= f.submit "Save Capture Settings", class: "btn btn--primary self-start" %>
        <% end %>

        <%# Watched Channels %>
        <div class="separator mbe-4"></div>
        <h3 class="font-bold text-xs mbe-2 text-subtle">Watched Channels</h3>
        <% if @watched_channels.any? %>
          <div class="flex flex-col gap-half mbe-4">
            <% @watched_channels.each do |ch| %>
              <div class="flex items-center justify-between pb-1 border-be-main">
                <div>
                  <span class="font-bold text-sm"><%= ch.channel_name %></span>
                  <span class="text-xs text-subtle"><%= ch.channel_id %> · <%= ch.capture_mode %></span>
                </div>
                <%= button_to settings_path, method: :patch, params: { section: "watched_channel_remove", channel_id: ch.channel_id }, class: "btn btn--negative btn--icon btn--borderless" do %>
                  <i class="ph ph-trash"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <%= form_with url: settings_path, method: :patch, class: "flex items-end gap mbe-6" do |f| %>
          <%= hidden_field_tag :section, "watched_channel_add" %>
          <% if @unwatched_channels.any? %>
            <div class="flex-2" data-controller="searchable-select">
              <label class="text-sm font-bold mbe-1 block">Channel</label>
              <input type="text" class="input mbe-1" placeholder="Search channels..." data-searchable-select-target="input" data-action="input->searchable-select#filter">
              <select name="channel_select" class="input" data-searchable-select-target="select">
                <option value="">— select a channel —</option>
                <% @unwatched_channels.each do |ch| %>
                  <option value="<%= ch[:id] %>|<%= ch[:name] %>" data-name="<%= ch[:name].downcase %>"><%= ch[:name] %></option>
                <% end %>
              </select>
            </div>
          <% elsif @slack_configured %>
            <p class="text-sm text-subtle">All your channels are already watched.</p>
          <% else %>
            <p class="text-sm text-subtle">Configure Slack tokens above to see your channels.</p>
          <% end %>
          <div class="flex-1">
            <label class="text-sm font-bold mbe-1 block">Capture Mode</label>
            <select name="capture_mode" class="input">
              <option value="full_stream">Full Stream</option>
              <option value="involvement_only">Involvement Only</option>
              <option value="ignored">Ignored</option>
            </select>
          </div>
          <% if @unwatched_channels.any? %>
            <%= f.submit "Add Channel", class: "btn btn--primary" %>
          <% end %>
        <% end %>

        <%# Noise Filters %>
        <div class="separator mbe-4"></div>
        <h3 class="font-bold text-xs mbe-2 text-subtle">Noise Filters</h3>
        <% if @noise_filters.any? %>
          <div class="flex flex-col gap-half mbe-4">
            <% @noise_filters.each do |nf| %>
              <div class="flex items-center justify-between pb-1 border-be-main">
                <div>
                  <span class="font-bold text-sm"><%= nf.category %></span>
                  <span class="text-xs text-subtle"><%= nf.description %></span>
                </div>
                <%= button_to settings_path, method: :patch, params: { section: "noise_filter_remove", filter_id: nf.id }, class: "btn btn--negative btn--icon btn--borderless" do %>
                  <i class="ph ph-trash"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <%= form_with url: settings_path, method: :patch, class: "flex items-end gap" do |f| %>
          <%= hidden_field_tag :section, "noise_filter_add" %>
          <div class="flex-1">
            <label class="text-sm font-bold mbe-1 block">Category</label>
            <input type="text" name="filter_category" class="input" placeholder="deploy_notification" required>
          </div>
          <div class="flex-2">
            <label class="text-sm font-bold mbe-1 block">Description</label>
            <input type="text" name="filter_description" class="input" placeholder="Automated deploy notifications" required>
          </div>
          <%= f.submit "Add Filter", class: "btn btn--primary" %>
        <% end %>
      </div>
    </div>

    <%# Calendar %>
    <div data-settings-nav-target="panel" id="calendar" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-calendar"></i> Google Calendar
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "calendar" %>
          <div data-controller="password-reveal">
            <div class="flex items-center gap-half mbe-1">
              <label class="text-sm font-bold block">Secret iCal URL</label>
              <% has_url = EncryptedSetting.get("credentials", "google_ical_url").present? %>
              <i class="ph <%= has_url ? 'ph-check-circle' : 'ph-circle-dashed' %> status-icon <%= has_url ? 'status-icon--ok' : 'status-icon--pending' %>"></i>
            </div>
            <div class="group">
              <input type="password" name="google_ical_url" data-password-reveal-target="input"
                     class="input" placeholder="<%= has_url ? 'Configured — leave blank to keep' : 'https://calendar.google.com/calendar/ical/.../basic.ics' %>">
              <button type="button" class="btn btn--icon" data-action="password-reveal#toggle" title="Toggle visibility">
                <i class="ph ph-eye" data-password-reveal-target="icon"></i>
              </button>
            </div>
            <p class="text-xs mbs-1 text-subtle">
              <a href="https://calendar.google.com/calendar/r/settings" target="_blank">Open Google Calendar Settings</a> → click your calendar on the left → scroll to "Secret address in iCal format" → copy the URL
            </p>
          </div>
          <%= f.submit "Save Calendar URL", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

    <%# Repo Paths %>
    <% repo_paths = Setting.get("global", "repo_paths", default: {}) || {} %>
    <div data-settings-nav-target="panel" id="repo_paths" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-folder-open"></i> Local Repo Paths
        </h2>
        <p class="text-xs mbe-4 text-subtle">
          Map GitHub repo names to local directories for codebase analysis.
        </p>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "repo_paths" %>
          <div data-controller="repo-paths">
            <div data-repo-paths-target="list" class="flex flex-col gap-half mbe-2">
              <% repo_paths.each do |name, path| %>
                <div class="flex items-center gap-half" data-repo-paths-target="row">
                  <input type="text" name="repo_names[]" value="<%= name %>" class="input text-sm flex-1" placeholder="myorg/api">
                  <input type="text" name="repo_local_paths[]" value="<%= path %>" class="input text-sm flex-2" placeholder="/Users/you/src/api">
                  <button type="button" class="btn btn--negative btn--icon btn--borderless" data-action="repo-paths#remove">
                    <i class="ph ph-trash"></i>
                  </button>
                </div>
              <% end %>
            </div>
            <template data-repo-paths-target="template">
              <div class="flex items-center gap-half" data-repo-paths-target="row">
                <input type="text" name="repo_names[]" class="input text-sm flex-1" placeholder="myorg/api">
                <input type="text" name="repo_local_paths[]" class="input text-sm flex-2" placeholder="/Users/you/src/api">
                <button type="button" class="btn btn--negative btn--icon btn--borderless" data-action="repo-paths#remove">
                  <i class="ph ph-trash"></i>
                </button>
              </div>
            </template>
            <button type="button" class="btn btn--borderless text-xs" data-action="repo-paths#add">
              <i class="ph ph-plus"></i> Add Repo
            </button>
          </div>
          <%= f.submit "Save Repo Paths", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

    <%# Search %>
    <div data-settings-nav-target="panel" id="search" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-magnifying-glass"></i> Search
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex items-end gap" do |f| %>
          <%= hidden_field_tag :section, "search" %>
          <div class="flex-1">
            <label class="text-sm font-bold mbe-1 block">Default Similarity Threshold</label>
            <input type="number" name="search_default_threshold" value="<%= Setting.get('global', 'search_default_threshold', default: 0.75) %>" step="0.05" min="0" max="1" class="input">
          </div>
          <%= f.submit "Save", class: "btn btn--primary" %>
        <% end %>
      </div>
    </div>

    <%# Archive %>
    <div data-settings-nav-target="panel" id="compression" hidden>
      <div class="card">
        <h2 class="font-bold text-sm mbe-4 text-subtle">
          <i class="ph ph-archive"></i> Archive & Reanalysis
        </h2>
        <%= form_with url: settings_path, method: :patch, class: "flex flex-col gap" do |f| %>
          <%= hidden_field_tag :section, "compression" %>
          <div class="flex gap">
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Compress after (months)</label>
              <input type="number" name="compression_after_months" value="<%= Setting.get('global', 'compression_after_months', default: 6) %>" class="input">
            </div>
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Reanalysis threshold (messages)</label>
              <input type="number" name="reanalysis_message_threshold" value="<%= Setting.get('global', 'reanalysis_message_threshold', default: 3) %>" class="input">
            </div>
            <div class="flex-1">
              <label class="text-sm font-bold mbe-1 block">Reanalysis quiet period (min)</label>
              <input type="number" name="reanalysis_quiet_minutes" value="<%= Setting.get('global', 'reanalysis_quiet_minutes', default: 30) %>" class="input">
            </div>
          </div>
          <%= f.submit "Save Archive Settings", class: "btn btn--primary self-start" %>
        <% end %>
      </div>
    </div>

  </div>
</div>
