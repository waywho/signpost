= turbo_frame_tag "settings_openai" do
  .card
    %h2.font-bold.text-sm.mbe-4.text-subtle
      %i.ph.ph-cube
      OpenAI
    = form_with url: settings_openai_path, method: :patch, class: "flex flex-col gap" do |f|
      %div{data: { controller: "password-reveal" }}
        .flex.items-center.gap-half.mbe-1
          %label.text-sm.font-bold.block API Key
          %i{class: "ph #{@has_openai_key ? 'ph-check-circle' : 'ph-circle-dashed'} status-icon #{@has_openai_key ? 'status-icon--ok' : 'status-icon--pending'}"}
        .group
          = f.password_field :openai_api_key, placeholder: (@has_openai_key ? "Configured — leave blank to keep" : "sk-..."), data: { "password-reveal-target": "input" }
          %button.btn.btn--icon{type: "button", title: "Toggle visibility", data: { action: "password-reveal#toggle" }}
            %i.ph.ph-eye{data: { "password-reveal-target": "icon" }}
        %p.text-xs.mbs-1.text-subtle
          For vector embeddings. Get a key at
          = link_to "platform.openai.com", "https://platform.openai.com/api-keys", target: "_blank"
      = f.submit "Save", class: "btn btn--primary self-start"
