<%= turbo_frame_tag "dashboard_action_queue" do %>
  <div class="mbe-6">
    <div class="flex items-center justify-between mbe-4">
      <h2 class="font-bold flex items-center gap-half">
        <i class="ph ph-tray" style="color: var(--color-primary)"></i> Action Queue
        <span class="text-sm font-normal" style="color: var(--color-negative)">(<%= (total = ActionItem.pending.size) %> pending)</span>
      </h2>
      <%= render "dashboard/section_refresh", url: dashboard_action_queue_path, frame: "dashboard_action_queue" %>
    </div>

    <%# Actionable: create_ticket + delegate %>
    <% @actionable_items.each do |item| %>
      <%= render "action_items/card", item: item, developers: @developers_for_select, github_repos: @github_repos %>
    <% end %>

    <%# Needs Discussion %>
    <div>
      <h3 class="font-bold text-xs mbe-2 mbs-4 only:hidden" style="color: var(--color-text-subtle)">Needs Discussion</h3>
      <% @discussion_items.each do |item| %>
        <%= render "action_items/discuss_card", item: item %>
      <% end %>
    </div>

    <%# Acknowledge %>
    <div>
      <h3 class="font-bold text-xs mbe-2 mbs-4 only:hidden" style="color: var(--color-text-subtle)">Acknowledge</h3>
      <div class="card p-3 mbe-2">
        <% @acknowledge_items.each do |item| %>
          <%= render "action_items/acknowledge_card", item: item %>
        <% end %>
      </div>
    </div>

    <% if total == 0 %>
      <div class="card text-center" style="color: var(--color-text-subtle)">
        <i class="ph ph-check-circle mbe-4" style="font-size: var(--text-4xl); display: block; color: var(--color-positive)"></i>
        <p class="text-sm">All caught up. No pending actions.</p>
      </div>
    <% end %>
  </div>
<% end %>
