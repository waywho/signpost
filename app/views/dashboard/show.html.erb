<% content_for(:title, "Dashboard — Tech Lead OS") %>

<div class="flex items-center justify-between" style="margin-block-end: var(--size-6)">
  <h1 class="font-bold text-2xl">Daily Lead Briefing</h1>
  <span class="text-sm" style="color: var(--color-text-subtle)"><%= Date.current.strftime("%A, %B %-d") %></span>
</div>

<%= render "action_queue", items: @action_items, developers: @developers_for_select %>

<%= render "insights", alerts: @alerts, patterns: @patterns %>

<div class="dashboard-grid">
  <%= render "calendar", events: @today_events %>
  <%= render "team_overview", developers: @developers %>
  <%= render "active_delegations", delegations: @active_delegations %>
  <%= render "commitments", due: @due_commitments, overdue: @overdue_commitments %>
  <%= render "pr_reviews", reviews: @recent_pr_reviews, pr_queue: @pr_queue %>
  <%= render "daily_log", log: @daily_log %>
</div>
