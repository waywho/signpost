<% content_for(:title, "Dashboard — Tech Lead OS") %>

<div class="flex items-center justify-between mbe-6">
  <h1 class="font-bold text-2xl">Daily Lead Briefing</h1>
  <span class="text-sm" style="color: var(--color-text-subtle)"><%= Date.current.strftime("%A, %B %-d") %></span>
</div>

<%= turbo_frame_tag "dashboard_action_queue", src: action_queue_dashboard_path do %>
  <%= render "section_loading", label: "Action Queue" %>
<% end %>

<%= turbo_frame_tag "dashboard_insights", src: insights_dashboard_path do %>
  <%= render "section_loading", label: "Insights" %>
<% end %>

<div class="dashboard-grid">
  <%= turbo_frame_tag "dashboard_calendar", src: calendar_dashboard_path do %>
    <%= render "section_loading", label: "Calendar" %>
  <% end %>

  <%= turbo_frame_tag "dashboard_team_overview", src: team_overview_dashboard_path do %>
    <%= render "section_loading", label: "Team" %>
  <% end %>

  <%= turbo_frame_tag "dashboard_active_delegations", src: active_delegations_dashboard_path do %>
    <%= render "section_loading", label: "Delegations" %>
  <% end %>

  <%= turbo_frame_tag "dashboard_commitments", src: commitments_dashboard_path do %>
    <%= render "section_loading", label: "Commitments" %>
  <% end %>

  <%= turbo_frame_tag "dashboard_pr_reviews", src: pr_reviews_dashboard_path do %>
    <%= render "section_loading", label: "PR Reviews" %>
  <% end %>

  <%= turbo_frame_tag "dashboard_daily_log", src: daily_log_dashboard_path do %>
    <%= render "section_loading", label: "Daily Log" %>
  <% end %>
</div>
