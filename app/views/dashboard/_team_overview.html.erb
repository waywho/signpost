<div class="card">
  <div class="flex items-center justify-between mbe-4">
    <h2 class="font-bold flex items-center gap-half">
      <i class="ph ph-users-three" style="color: var(--color-primary)"></i> Team
      <span class="text-sm font-normal" style="color: var(--color-text-subtle)">(<%= developers.size %>)</span>
    </h2>
    <div class="flex items-center gap-half">
      <%= render "dashboard/section_refresh", url: dashboard_team_overview_path, frame: "dashboard_team_overview" %>
      <%= link_to "View all →", developers_path, class: "text-xs", style: "color: var(--color-text-subtle)" %>
    </div>
  </div>
  <% if developers.any? %>
    <ul class="flex flex-col gap-half">
      <% developers.each do |dev| %>
        <li class="flex items-center justify-between text-sm">
          <span class="font-bold"><%= dev.name %></span>
          <span style="color: var(--color-text-subtle)"><%= [dev.level, dev.role].compact.join(" · ") %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-center" style="color: var(--color-text-subtle)">No developers yet.</p>
  <% end %>
</div>
