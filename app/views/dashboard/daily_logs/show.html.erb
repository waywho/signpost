<%= turbo_frame_tag "dashboard_daily_log" do %>
  <div class="card dashboard-log" data-controller="daily-log">
    <div class="flex items-center justify-between mbe-4">
      <h2 class="font-bold flex items-center gap-half">
        <i class="ph ph-notebook" style="color: var(--color-primary)"></i> Today's Log
      </h2>
      <%= render "dashboard/section_refresh", url: dashboard_daily_log_path, frame: "dashboard_daily_log" %>
    </div>

    <%= form_with model: @daily_log, url: @daily_log.persisted? ? daily_log_path(@daily_log) : daily_logs_path do |f| %>
      <div class="flex gap" style="align-items: flex-start">
        <div class="flex flex-col gap-half" style="flex: 1">
          <label class="text-sm font-bold">EOD Notes</label>
          <%= f.text_area :eod_notes, rows: 5, placeholder: "What happened today?", class: "input" %>
        </div>

        <div class="flex flex-col gap-half" style="flex: 1">
          <label class="text-sm font-bold">Tomorrow's Priorities</label>
          <ul class="flex flex-col gap-half" data-daily-log-target="priorityList">
            <% (@daily_log.tomorrow_priorities.presence || [""]).each_with_index do |p, i| %>
              <li class="flex items-center gap-half">
                <input type="text" name="daily_log[tomorrow_priorities][]" value="<%= p %>" placeholder="Priority <%= i + 1 %>" class="input flex-1 text-sm">
                <button type="button" data-action="daily-log#removePriority" style="color: var(--color-text-subtle)"><i class="ph ph-x"></i></button>
              </li>
            <% end %>
          </ul>
          <button type="button" class="text-sm flex items-center gap-half" style="color: var(--color-primary)" data-action="daily-log#addPriority">
            <i class="ph ph-plus"></i> Add priority
          </button>
        </div>
      </div>

      <div class="flex justify-end mbs-4">
        <%= f.submit "Save log", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
<% end %>
