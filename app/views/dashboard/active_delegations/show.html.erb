<%= turbo_frame_tag "dashboard_active_delegations" do %>
  <div class="card">
    <div class="flex items-center justify-between mbe-4">
      <h2 class="font-bold flex items-center gap-half">
        <i class="ph ph-arrows-split text-accent"></i> Delegations
        <span class="text-sm font-normal text-subtle">(<%= @delegations.size %> active)</span>
      </h2>
      <div class="flex items-center gap-half">
        <%= render "dashboard/section_refresh", url: dashboard_active_delegations_path, frame: "dashboard_active_delegations" %>
        <%= link_to "View all →", delegations_path, class: "text-xs text-subtle" %>
      </div>
    </div>
    <% if @delegations.any? %>
      <ul class="flex flex-col gap-half">
        <% @delegations.each do |d| %>
          <li class="border-be-main pbe-2">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold"><%= d.summary.truncate(50) %></span>
              <% if d.urgency.in?(%w[critical high]) %>
                <span class="badge <%= urgency_badge_variant(d.urgency) %>"><%= d.urgency %></span>
              <% end %>
            </div>
            <div class="text-xs text-subtle">
              <%= d.developer&.name || d.developer_name || "Unassigned" %> · <%= d.status.tr("_", " ") %>
              <% if d.status == "blocked" %><i class="ph ph-warning text-negative"></i><% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-center text-subtle">No active delegations.</p>
    <% end %>
  </div>
<% end %>
