<div class="card">
  <h2 class="font-bold flex items-center gap-half" style="margin-block-end: var(--size-4)">
    <i class="ph ph-git-pull-request" style="color: var(--color-primary)"></i> PR Reviews
    <span class="text-sm font-normal" style="color: var(--color-text-subtle)">Last 5</span>
  </h2>
  <% if reviews.any? %>
    <ul class="flex flex-col gap-half">
      <% reviews.each do |pr| %>
        <li style="border-block-end: 1px solid var(--color-border); padding-block-end: var(--size-2)">
          <div class="flex items-center justify-between text-sm">
            <span class="font-bold"><%= pr.repo %>#<%= pr.pr_number %></span>
            <% if pr.recommendation.present? %>
              <%
                color = case pr.recommendation
                        when "APPROVE" then "var(--color-positive)"
                        when "REQUEST_CHANGES" then "var(--color-negative)"
                        else "#f97316"
                        end
              %>
              <span class="text-xs font-bold" style="color: <%= color %>"><%= pr.recommendation.tr("_", " ").downcase.capitalize %></span>
            <% end %>
          </div>
          <span class="text-xs" style="color: var(--color-text-subtle)"><%= pr.pr_title&.truncate(50) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-center" style="color: var(--color-text-subtle)">No PR reviews yet.</p>
  <% end %>
</div>
