<% if events.present? %>
  <div class="card">
    <h2 class="font-bold flex items-center gap-half" style="margin-block-end: var(--size-4)">
      <i class="ph ph-calendar" style="color: var(--color-primary)"></i> Today's Schedule
      <span class="text-sm font-normal" style="color: var(--color-text-subtle)">(<%= events.size %>)</span>
    </h2>

    <div class="flex flex-col gap-half">
      <% events.each do |event| %>
        <div class="flex items-center gap" style="padding-block: var(--size-2); border-block-end: 1px solid var(--color-border)">
          <div class="text-xs" style="color: var(--color-text-subtle); min-inline-size: 5rem; flex-shrink: 0">
            <%= event[:start_time].strftime("%-I:%M %p") %>
          </div>

          <div class="flex flex-col flex-1" style="min-inline-size: 0">
            <span class="font-bold text-sm" style="<%= 'color: var(--color-primary)' if event[:is_oneone] %>">
              <%= event[:title] %>
            </span>
            <% if event[:matched_developer] %>
              <span class="text-xs" style="color: var(--color-text-subtle)">
                <i class="ph ph-user"></i> <%= event[:matched_developer].name %>
                <% if event[:matched_developer].role.present? %> · <%= event[:matched_developer].role %><% end %>
              </span>
            <% end %>
          </div>

          <% if event[:is_oneone] && event[:matched_developer] && event[:start_time] > Time.current %>
            <%= link_to developer_path(event[:matched_developer]), class: "text-xs", style: "color: var(--color-primary); flex-shrink: 0" do %>
              <i class="ph ph-brain"></i> Prep
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% elsif events.nil? %>
  <%# Not configured — don't show anything %>
<% else %>
  <div class="card text-center" style="color: var(--color-text-subtle)">
    <i class="ph ph-calendar-blank" style="font-size: var(--text-2xl); display: block; margin-block-end: var(--size-2)"></i>
    <p class="text-sm">No events today.</p>
  </div>
<% end %>
